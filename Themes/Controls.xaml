<!--
  형태 스타일이 사는 곳입니다. 색은 여기서 정하지 않고 Kotodama.xaml 토큰만 참조합니다.
  (색의 유일한 출처는 Kotodama.xaml 이고, ReleaseTools/check_theme.sh 가 그 전제를 검사합니다.)
  근거는 PRD_UI.md §2 / §4.
-->
<ResourceDictionary x:Class="KotodamanWordFinder.Themes.Controls"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!--
      P3 かな 뱃지. 게임은 카드 좌상단의 흰 원 + 갈색 글자 + 탠 링입니다.
      지름은 호출부가 정합니다(빈칸 버튼만 스타디움으로 늘어남).
    -->
    <Style x:Key="KanaChipStyle" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="Background" Value="{StaticResource Bg.Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ChipBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Pill}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource Accent.OrangeDeep}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource Accent.Orange}"/>
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource Accent.OrangeDeep}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ChipBorder" Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      P6 상단 상태 칩. 게임은 배경 사진 위 반투명 다크 알약에 흰 글자(img1 残り8日 / 7,985)인데,
      크림 팔레트에서 Chip.Dark 는 밝은 값(#DFD8C8)이라 흰 글자가 1.4 로 안 읽힙니다.
      그래서 게임의 '어두운 면 + 밝은 글자'를 명암만 뒤집어 '밝은 면 + 짙은 글자'로 옮깁니다(7.6).

      면이 창 바탕(#E4DED1)과 1.06 이라 면만으로는 알약 모양이 안 보입니다. 알약을 세우는 건
      Line.TanStrong 테두리(바탕과 1.56)이고, 그래서 상태가 바뀌어도 테두리는 그대로 둡니다.
      면과 글자만 한 벌로 갈아끼웁니다(MainWindow.ShowStatusChip 한 곳).

      Label 인 이유: Foreground 를 면과 같은 자리에서 정하려면 컨트롤 하나가 둘 다 가져야 합니다.
      TextBlock 은 테두리·반경이 없고, Border 는 글자색을 자식이 따로 갖게 되어 짝이 흩어집니다.

      Radius.Pill(999)을 쓰지 않고 높이의 절반(13)을 직접 적은 이유: WPF Border 는 큰 반경을
      가로/세로 각각 절반으로 잘라 타원 호를 그립니다. 정사각형에 가까운 かな 뱃지에서는 그게
      곧 원이라 맞지만, 길고 납작한 이 칩에서는 스타디움이 아니라 눈알 모양이 되고 양 끝
      글자가 곡선에 닿습니다(실제로 그렇게 나왔습니다). 높이를 고정해야 반경이 정확해집니다.
    -->
    <Style x:Key="StatusChipStyle" TargetType="Label">
        <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="13"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      P7 라벨 뱃지. 게임의 リーダー / 発動可 태그처럼 면·선·글자 3톤 한 벌입니다(img1/img2).
      이름이나 요약 문장에 섞여 있던 표시를 빼내 여기에 담습니다.

      기본 3톤은 게임 リーダー 태그와 같은 자주 계열이고, 뜻이 다른 뱃지는 호출부가
      Themes.Controls.LabelBadge() 로 세 톤을 한 번에 갈아끼웁니다. Label 인 이유는
      StatusChipStyle 과 같습니다 - 면과 글자가 한 컨트롤에 있어야 짝이 흩어지지 않습니다.

      Radius.Pill(999) 대신 높이의 절반(9)을 적은 이유도 같습니다. 큰 반경은 납작한
      뱃지에서 타원 호가 되어 눈알 모양이 됩니다.
    -->
    <Style x:Key="LabelBadgeStyle" TargetType="Label">
        <Setter Property="Background" Value="{StaticResource Rose.Face}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Rose.Line}"/>
        <Setter Property="Foreground" Value="{StaticResource Rose.Text}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      P8 경고 배너. 게임의 スカー強襲 헤더(빨강 테두리 + 상단 무지개 엣지)를 6개 창이 공유하는
      상태줄 하나에 얹습니다. 평소(비경고)엔 지금과 똑같이 아무것도 안 보여야 하므로 기본값은
      투명 면 + 테두리 0 + Padding 0 이고, 경고일 때만 Themes.Controls.SetAlertBanner() 가
      Alert.Face/Alert.Line/Alert.Text 세 톤과 두께를 한 번에 갈아끼웁니다(면·글자가 흩어지지
      않도록 - P7 때 이 문제로 6곳이 사고났습니다).

      "상단 무지개 엣지"는 새 그라디언트 색을 만들지 않고 BorderThickness 상단만 두껍게 주는
      방식(1,3,1,1)으로 Alert.Line 단색으로 축약합니다 - 그라디언트는 Kotodama.xaml 밖의 새
      색 출처가 되므로 여기서는 만들지 않습니다.
    -->
    <Style x:Key="AlertBannerStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!--
      P1 크림 카드 모달. 게임의 クエスト / デッキ編成 패널을 창 틀 자체로 옮긴 것입니다.
      Kotodaman_UI_1.jpg / _2.jpg 의 카드 해부: 큰 반경 + 이중 테두리 + 중앙 제목 +
      마름모 구분선 + 우상단 X.

      WindowStyle=None 을 쓰는 대가로 네이티브가 주던 것을 여기서 전부 되만듭니다.
      WindowChrome 이 이동/8방향 리사이즈/더블클릭 최대화/스냅/시스템 메뉴를 돌려주고,
      Alt+F4 와 창 이름(Title)은 원래대로 남습니다. 최대화가 작업표시줄을 덮지 않게
      하는 보정만 Controls.xaml.cs 가 WM_GETMINMAXINFO 로 합니다.

      AllowsTransparency 를 켠 이유: 28px 반경과 창 그림자는 창 밖이 투명해야만 나옵니다.
      이 앱에는 자식 HWND(WebBrowser/WindowsFormsHost)가 없어 그 대가를 피할 이유가 없습니다.
    -->

    <!-- ⑥ 우상단 X. 게임과 같이 최소화/최대화 버튼은 두지 않습니다(7개 창 모두 모달). -->
    <Style x:Key="ModalCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!--
                      IsHitTestVisibleInChrome 은 WindowChrome 이 히트테스트로 '직접 맞힌'
                      요소에서만 읽습니다(조상으로 거슬러 올라가지 않습니다). 그래서 Button 이
                      아니라 실제로 맞는 Border 에 걸고, 글리프는 히트테스트에서 빼둡니다.
                      이걸 빼면 제목줄 영역이라 X 가 마우스에 아예 반응하지 않습니다.
                    -->
                    <Border x:Name="CloseFace"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="{StaticResource Radius.Pill}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="CloseGlyph"
                              Data="M 0,0 L 13,13 M 13,0 L 0,13"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              IsHitTestVisible="False"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <!--
                      트리거 순서가 곧 우선순위입니다(뒤에 오는 것이 이깁니다).
                      포커스는 '테두리'로만 표시해 면색 싸움에서 빠집니다 - 예전에 포커스가
                      뒤에 있어서 눌림의 진한 면을 덮고 흰 획만 남아 X 가 안 보였습니다.
                    -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CloseFace" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                            <Setter TargetName="CloseFace" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CloseFace" Property="Background" Value="{StaticResource Alert.Face}"/>
                            <Setter TargetName="CloseGlyph" Property="Stroke" Value="{StaticResource Alert.Text}"/>
                        </Trigger>
                        <!-- 눌림은 면이 진해지므로 획을 흰색으로 뒤집습니다(대비 6.9). -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CloseFace" Property="Background" Value="{StaticResource Alert.Text}"/>
                            <Setter TargetName="CloseGlyph" Property="Stroke" Value="{StaticResource Text.OnAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      다이얼로그 배경 장식 3종(구름/물결/ことだまん). Docs/PRD_Background.md 안 B.
      ModalCardWindowStyle 템플릿 안에서만 두 번(타이틀 행 작게, 본문 오버레이 크게) 쓰므로
      Geometry 를 리소스로 빼서 좌표 문자열을 중복해 박지 않습니다.

      ことだまん 글자는 TextBlock 이 아니라 FormattedText.BuildGeometry 로 구운 윤곽선입니다.
      TextBlock 을 쓰면 배포 대상 PC에 그 폰트가 없을 때 글자가 깨지지만(두부), 구운 Geometry는
      좌표값이라 폰트 설치 여부와 무관하게 항상 같은 모양으로 보입니다. 좌표는 장식용이라
      정밀도가 필요 없어 정수로 반올림해 문자열 길이를 줄였습니다.
    -->
    <PathGeometry x:Key="Motif.Cloud" Figures="M2,13 C0,13 0,9 3,8 C2,5 5,3 8,4 C9,1 14,1 15,4 C18,3 21,5 20,8 C23,9 23,13 20,13 Z"/>
    <PathGeometry x:Key="Motif.Wave" Figures="M0,7 C3,3 6,3 9,7 C12,11 15,11 18,7 C21,3 24,3 27,7 C30,11 33,11 36,7"/>
    <PathGeometry x:Key="Motif.KotodamanText" FillRule="Nonzero" Figures="M6,16L8,18C6,19 6,20 6,21 6,21 6,22 6,22 6,22 6,22 7,22 7,23 8,23 9,23 10,23 11,23 12,23L13,23C16,23,18,23,21,23L22,26C19,26 16,26 13,26 9,26 6,26 5,25 3,24 2,23 2,21 2,19 3,17 6,16z M17,8C18,8,19,8,20,8L21,11C20,11 20,11 19,11 19,11 18,12 18,12 17,12 16,13 13,14L12,12C12,12 13,11 14,11 12,11 9,11 4,11L4,8C6,8,10,8,17,8z M32,6L36,6 36,7 36,7C36,9 36,11 36,13 38,12 40,11 44,10L45,13C40,14 36,16 34,17 31,18 30,20 30,21 30,23 32,24 36,24L37,24C39,24,42,23,45,23L46,26C43,26 41,27 38,27 35,27 33,26 32,26 30,26 29,25 28,24 27,24 27,22 27,21 27,18 29,16 33,14 33,12 32,9 32,6z M59,19L61,20C61,21 60,22 60,22 60,22 60,23 61,23 61,23 61,23 62,23 63,23 64,23 65,23 67,23 69,23 70,23L71,26C69,26 67,26 65,26 63,26 62,26 61,26 60,26 59,25 58,25 57,24 57,23 57,22 57,21 58,20 59,19z M68,13C69,13,69,13,70,13L70,16C69,16 69,16 68,16 66,16 62,16 59,16L58,13C62,13,65,13,68,13z M54,6L57,6C57,6 57,7 57,7 57,8 57,8 57,9L65,9 65,12 57,12C57,14 56,17 55,20 54,23 53,25 51,27L49,25C50,24 51,22 52,19 53,16 53,14 54,12L50,12 50,9 54,9C54,8,54,6,54,6z M66,5C67,7,67,8,68,9L66,10C65,8,65,7,64,6L66,5z M69,5C70,6,70,7,71,8L69,9C69,8,68,6,68,5L69,5z M80,21C79,21 79,21 78,21 78,21 77,22 77,22 77,23 78,24 80,24 82,24 83,23 83,23L83,21C82,21,81,21,80,21z M83,6L86,6 86,9 94,9 94,11 86,11 86,14 93,14 93,16 86,16 86,19C89,20,92,22,94,23L92,26C90,25,88,23,86,22L86,23C86,23 86,23 86,24 86,25 86,25 85,26 84,26 82,27 80,27 79,27 77,26 76,25 75,25 74,24 74,22 74,21 75,20 76,19 77,19 78,18 80,18 81,18 82,18 83,18L83,16 75,16 75,14 83,14 83,11 74,11 74,9 83,9 83,6z M105,6L109,7C107,10 106,13 105,15 105,15 106,15 106,15 108,15 109,15 109,17L110,21C110,22 110,23 110,23 111,23 111,24 112,24 114,24 115,21 116,16L119,17C119,21 118,23 116,25 115,26 114,27 112,27 110,27 109,26 108,25 107,25 107,23 106,21L106,19C106,19 106,18 106,18 106,18 106,17 105,17 105,17 104,18 104,18 103,19 102,20 101,23 101,24 100,25 99,27L96,26 101,15C101,14,103,11,105,6z"/>

    <Style x:Key="ModalCardWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <!-- 최대화가 작업표시줄을 덮지 않게 하는 보정. 이유는 Controls.xaml.cs 참조. -->
        <EventSetter Event="Loaded" Handler="ModalWindow_Loaded"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <!--
                  CaptionHeight 는 창 최상단부터 잽니다. 그림자 여백(10) + 제목줄(58) = 68.
                  ResizeBorderThickness 는 그림자 여백보다 조금 크게 잡아, 눈에 보이는
                  카드 가장자리를 집어도 크기 조절이 걸리게 합니다.
                -->
                <shell:WindowChrome CaptionHeight="68"
                                    ResizeBorderThickness="14"
                                    CornerRadius="0"
                                    GlassFrameThickness="0"
                                    UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Grid x:Name="WindowRoot" Margin="10">
                        <!--
                          카드 면은 Bg.Panel 이 아니라 Bg.Backdrop 입니다. 이 카드가 곧 창 바탕이고,
                          창 안의 섹션 패널들이 이미 Bg.Panel(한 단계 밝은 면)이라 같은 토큰을 쓰면
                          섹션이 배경에 묻힙니다. 지금의 면 계층(바탕 < 패널 < 필드)이 그대로 삽니다.

                          그림자는 빈 Border 에만 겁니다. 카드 안쪽 내용까지 효과 파이프라인에
                          넣으면 수백 행짜리 목록이 갱신마다 비트맵으로 다시 그려집니다.
                        -->
                        <Border x:Name="CardShadow"
                                Background="{StaticResource Bg.Backdrop}"
                                CornerRadius="{StaticResource Radius.Modal}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.32"/>
                            </Border.Effect>
                        </Border>

                        <!-- ② 이중선: 바깥 탠 선 + 5px 안쪽 얇은 선 -->
                        <Border x:Name="CardEdge"
                                BorderBrush="{StaticResource Line.TanStrong}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource Radius.Modal}"/>
                        <Border x:Name="CardEdgeInner"
                                Margin="5"
                                BorderBrush="{StaticResource Line.Tan}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.ModalInner}"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- ① 상단 중앙 장식. 게임 카드의 세 잎 장식(가운데 물방울 + 좌우 잎)입니다. -->
                            <Path x:Name="CardOrnament"
                                  Grid.Row="0"
                                  Data="M 13,0 C 15.4,0 16.4,2.6 15.4,6.2 L 13,14 L 10.6,6.2 C 9.6,2.6 10.6,0 13,0 Z M 16.6,0.6 C 20.4,0.8 24.4,4.4 26,10.4 C 22.2,7.6 18.6,4.4 16.6,0.6 Z M 9.4,0.6 C 5.6,0.8 1.6,4.4 0,10.4 C 3.8,7.6 7.4,4.4 9.4,0.6 Z"
                                  Fill="{StaticResource Line.TanStrong}"
                                  Width="26" Height="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  Margin="0,10,0,0"/>

                            <!--
                              ①-보조 배경 장식(구름+물결). 제목/닫기 버튼과 겹치지 않게 왼쪽 구석에만
                              하늘+물 한 쌍으로 몰아 둡니다. 밀도는 타이틀 행 1~2개(PRD 기준)로 여기 2개.
                            -->
                            <Path Grid.Row="0"
                                  Data="{StaticResource Motif.Cloud}"
                                  Fill="{StaticResource Line.TanStrong}"
                                  Width="26" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="20,10,0,0"
                                  Opacity="0.8"/>
                            <Path Grid.Row="0"
                                  Data="{StaticResource Motif.Wave}"
                                  Stroke="{StaticResource Line.Soft}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="34" Height="8" Stretch="Uniform"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom"
                                  Margin="20,0,0,8"
                                  Opacity="0.8"/>

                            <!-- ③ 제목은 창의 Title 을 그대로 읽습니다. 창마다 제목을 두 번 적지 않습니다. -->
                            <TextBlock Grid.Row="0"
                                       Text="{TemplateBinding Title}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.Primary}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Bottom"
                                       Margin="64,0,64,5"/>

                            <Button Grid.Row="0"
                                    x:Name="PART_ModalClose"
                                    Style="{StaticResource ModalCloseButtonStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,4,18,0"
                                    Click="ModalClose_Click"
                                    AutomationProperties.Name="닫기"
                                    ToolTip="닫기"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                            <!-- ④ 제목 아래 얇은 가로선, 양 끝에 작은 마름모 -->
                            <Grid Grid.Row="1" Height="9" Margin="30,0,30,0">
                                <Rectangle Height="1"
                                           VerticalAlignment="Center"
                                           Margin="11,0,11,0"
                                           Fill="{StaticResource Line.Soft}"/>
                                <Path Data="M 4.5,0 L 9,4.5 L 4.5,9 L 0,4.5 Z"
                                      Fill="{StaticResource Line.Soft}"
                                      Width="9" Height="9"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"/>
                                <Path Data="M 4.5,0 L 9,4.5 L 4.5,9 L 0,4.5 Z"
                                      Fill="{StaticResource Line.Soft}"
                                      Width="9" Height="9"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 기본 Window 템플릿이 주던 어도너 레이어를 되돌려 놓습니다. -->
                            <AdornerDecorator Grid.Row="2" Margin="8,6,8,10">
                                <ContentPresenter/>
                            </AdornerDecorator>

                            <!--
                              본문 워터마크. Bg.Panel/Bg.Field 가 완전 불투명이라 ContentPresenter
                              "뒤"에 깔면 안 보이므로, 같은 Row 2 안에서 ContentPresenter 다음 순서로
                              둬 z-order상 카드 위에 얹고 IsHitTestVisible=False 로 클릭을 그대로
                              통과시킵니다. 타이틀 행(0.8)보다 옅은 0.5 - 본문은 실제로 읽는 글자가
                              있어 같은 진하기를 쓰면 안 됩니다. 밀도는 PRD 기준 2~4개로 3개.

                              실측 결과 - 안내문이 폭 전체를 쓰는 창(예: 문자 상태 편집)에서는 상단
                              구석 글자가 카드마다 다른 위치까지 뻗어 나와, 구름을 본문 0.5 그대로
                              두면 그 글자 위에 그대로 얹혀 대비가 떨어집니다(실캡처로 확인). 코너에
                              걸치는 구름·물결은 개별 Opacity 를 한 번 더 곱해 더 옅게 낮추고, 항상
                              비어 있는 걸 확인한 바닥 여백에만 놓는 ことだまん 글자는 그대로 0.5를
                              씁니다.
                            -->
                            <Grid Grid.Row="2" IsHitTestVisible="False" Opacity="0.5">
                                <Path Data="{StaticResource Motif.Cloud}"
                                      Fill="{StaticResource Line.TanStrong}"
                                      Width="40" Height="22" Stretch="Uniform"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Margin="0,8,16,0"
                                      Opacity="0.55"/>
                                <Path Data="{StaticResource Motif.Wave}"
                                      Stroke="{StaticResource Line.Soft}"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="68" Height="16" Stretch="Uniform"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Bottom"
                                      Margin="24,0,0,20"
                                      Opacity="0.55"/>
                                <Path Data="{StaticResource Motif.KotodamanText}"
                                      Fill="{StaticResource Line.TanStrong}"
                                      Width="150" Height="28" Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,16"/>
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 최대화하면 카드가 화면을 꽉 채우므로 여백/반경/그림자를 접습니다. -->
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowRoot" Property="Margin" Value="0"/>
                            <Setter TargetName="CardShadow" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="CardShadow" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="CardEdge" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="CardEdgeInner" Property="CornerRadius" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      P5 하단 액션 버튼. 게임 img3 의 ひとりで, img2 의 編成 버튼입니다.
      원본을 재보면 폭 605 x 높이 152 (1080 폭 기준), 즉 가로세로비 4 에 가까운
      완전한 스타디움이고 면은 아이보리, 글자는 짙고 굵습니다. 앱은 다이얼로그
      하단이라 높이를 44 로 잡고 그 비율(44 x 4 = 176)을 MinWidth 로 옮겼습니다.

      Radius.Pill(999)이 아니라 22 를 직접 적은 이유는 StatusChipStyle 과 같습니다 -
      WPF Border 는 큰 반경을 가로/세로 각각 절반으로 잘라 타원 호를 그려서, 납작한
      버튼에서는 스타디움이 아니라 눈알이 됩니다. 높이를 고정해야 반경이 정확합니다.

      아이보리 면은 창 바탕(Bg.Backdrop)과 1.21 이라 면만으로는 버튼이 안 보입니다.
      버튼을 세우는 건 Line.TanStrong 2px 테두리(바탕과 1.56)와 그림자입니다.
      게임 원본도 같은 구조로 배경에서 떠 있습니다.

      옆에 취소가 있는 것이 게임과 다른 점입니다. 아이보리는 순한 색이라 색만으로는
      취소를 못 이기므로 위계를 크기/굵기/무게로 세웁니다 - 이쪽은 H44 Bold 14 에
      2px 테두리와 그림자, 취소(GhostButtonStyle)는 H34 보통 13 에 1px 테두리와
      투명 면입니다.
    -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinWidth" Value="176"/>
        <Setter Property="Padding" Value="26,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Background" Value="{StaticResource Bg.Ivory}"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ActionFace"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="22"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.22"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!--
                      커스텀 템플릿은 기본 트리거를 지우므로 네 상태를 직접 넣습니다.
                      뒤에 오는 트리거가 이기므로 비활성이 마지막입니다.
                      면이 바뀌어도 Text.Primary 가 계속 읽힙니다(호버 10.8, 눌림 5.4).
                    -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ActionFace" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ActionFace" Property="Background" Value="{StaticResource Bg.Field}"/>
                            <Setter TargetName="ActionFace" Property="BorderBrush" Value="{StaticResource Accent.OrangeDeep}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ActionFace" Property="Background" Value="{StaticResource Accent.Orange}"/>
                            <Setter TargetName="ActionFace" Property="BorderBrush" Value="{StaticResource Accent.OrangeDeep}"/>
                        </Trigger>
                        <!-- 비활성은 그림자를 걷어 평평하게 만듭니다. 떠 있음 = 누를 수 있음. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ActionFace" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="ActionFace" Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      하단 액션 옆의 취소/닫기. 주 액션과 한 벌이라 같은 파일에 둡니다 -
      한쪽만 고치면 위계가 무너지므로 두 스타일을 붙여 놓습니다.

      투명 면인 이유: 면을 채우면 아이보리 주 액션과 면적 싸움이 붙습니다.
      테두리가 Line.Tan 이 아니라 Line.TanStrong 인 건 창 바탕과의 대비 때문입니다
      (Line.Tan 은 1.35 라 바탕에 녹습니다).
    -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="GhostFace"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="17"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="GhostFace" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GhostFace" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="GhostFace" Property="Background" Value="{StaticResource Bg.PanelInner}"/>
                        </Trigger>
                        <!--
                          채울 면이 없으니 비활성은 글자만 흐려집니다. 테두리까지 Line.Tan 으로
                          내리면 창 바탕과 1.35 가 되어 버튼 자리 자체가 사라집니다.
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
