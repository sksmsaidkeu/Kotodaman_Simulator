<!--
  형태 스타일이 사는 곳입니다. 색은 여기서 정하지 않고 Kotodama.xaml 토큰만 참조합니다.
  (색의 유일한 출처는 Kotodama.xaml 이고, ReleaseTools/check_theme.sh 가 그 전제를 검사합니다.)
  근거는 PRD_UI.md §2 / §4.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      P3 かな 뱃지. 게임은 카드 좌상단의 흰 원 + 갈색 글자 + 탠 링입니다.
      지름은 호출부가 정합니다(빈칸 버튼만 스타디움으로 늘어남).
    -->
    <Style x:Key="KanaChipStyle" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        <Setter Property="Background" Value="{StaticResource Bg.Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ChipBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Pill}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource Accent.OrangeDeep}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource Accent.Orange}"/>
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource Accent.OrangeDeep}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ChipBorder" Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
