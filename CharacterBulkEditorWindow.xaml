<Window x:Class="KotodamanWordFinder.CharacterBulkEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="캐릭터 일괄 수정"
        Width="1500"
        Height="880"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#10131A"
        Foreground="#F4F7FB"
        FontFamily="Malgun Gothic"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="EditorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A3342"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#46546A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorButtonStyle}">
            <Setter Property="Background" Value="#4B8BFF"/>
            <Setter Property="BorderBrush" Value="#4B8BFF"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202734"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="CaretBrush" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#3A4658"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#222A37"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#3A4658"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  RecognizesAccessKey="True"/>
                                                <Border Grid.Column="1"
                                                        Background="#1B222D"
                                                        BorderBrush="#3A4658"
                                                        BorderThickness="1,0,0,0"
                                                        CornerRadius="0,6,6,0">
                                                    <Path Width="10"
                                                          Height="6"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="#C8D1DE"
                                                          Data="M 0 0 L 10 0 L 5 6 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#293442"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#547086"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#263746"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#66D9EF"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Visibility="Hidden"
                                     Margin="8,2,38,2"
                                     Padding="3,0"
                                     Background="#222A37"
                                     Foreground="#F4F7FB"
                                     CaretBrush="#F4F7FB"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#171C26"
                                        BorderBrush="#46546A"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_EditableTextBox" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GridEditComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <!-- 표 행 안에서 기본 39px ComboBox가 행을 덮지 않도록 전용 컴팩트 크기를 사용합니다. -->
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#222A37"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#29465A"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#547086"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4051"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#66D9EF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#718096"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8EDF5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#171C26"
                BorderBrush="#2A3342"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="등록 캐릭터 일괄 수정"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#9EACBE"
                               TextWrapping="Wrap"
                               Text="웹 등록 검사기처럼 현재 characters.json의 캐릭터를 표에서 직접 수정합니다. 일러를 보면서 이름·검색 별칭·문자·등급·속성·종족·그룹을 직접 입력·복붙할 수 있으며, 이미지·모드시프트·조건 문자·미라클 설정 자체는 그대로 유지됩니다."/>
                </StackPanel>
                <TextBlock x:Name="CountText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="#8FE3B1"
                           FontWeight="SemiBold"
                           Text="0 / 0명"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#171C26"
                BorderBrush="#2A3342"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             MinHeight="36"
                             ToolTip="이름, 검색 별칭, 문자, 그룹, 등급, 속성, 종족 검색"
                             TextChanged="SearchTextBox_TextChanged"/>
                    <ComboBox x:Name="CategoryFilterComboBox"
                              Grid.Column="2"
                              MinHeight="36"
                              SelectionChanged="FilterComboBox_SelectionChanged"/>
                    <ComboBox x:Name="AttributeFilterComboBox"
                              Grid.Column="4"
                              MinHeight="36"
                              SelectionChanged="FilterComboBox_SelectionChanged"/>
                    <ComboBox x:Name="SpeciesFilterComboBox"
                              Grid.Column="6"
                              MinHeight="36"
                              SelectionChanged="FilterComboBox_SelectionChanged"/>
                    <CheckBox x:Name="IncompleteOnlyCheckBox"
                              Grid.Column="7"
                              Margin="16,0,0,0"
                              Content="속성·종족 미입력만"
                              Checked="IncompleteOnlyCheckBox_Changed"
                              Unchecked="IncompleteOnlyCheckBox_Changed"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.RowSpan="2"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="#AEB8C8"
                               Text="체크 항목 일괄 변경&#10;(빈칸=유지)"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Margin="2,0,0,4"
                               Foreground="#9EACBE"
                               FontSize="11"
                               Text="등급"/>
                    <TextBlock Grid.Row="0" Grid.Column="4"
                               Margin="2,0,0,4"
                               Foreground="#9EACBE"
                               FontSize="11"
                               Text="속성"/>
                    <TextBlock Grid.Row="0" Grid.Column="6"
                               Margin="2,0,0,4"
                               Foreground="#9EACBE"
                               FontSize="11"
                               Text="종족"/>
                    <TextBlock Grid.Row="0" Grid.Column="8"
                               Margin="2,0,0,4"
                               Foreground="#66D9EF"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="소속 그룹"/>
                    <TextBox x:Name="BatchCategoryTextBox"
                             Grid.Row="1" Grid.Column="2"
                             MinHeight="34"
                             ToolTip="예: 스페셜, 콜라보. 비워 두면 변경하지 않습니다."/>
                    <TextBox x:Name="BatchAttributeTextBox"
                             Grid.Row="1" Grid.Column="4"
                             MinHeight="34"
                             ToolTip="예: 火. 비워 두면 유지, '미입력'을 입력하면 지웁니다."/>
                    <TextBox x:Name="BatchSpeciesTextBox"
                             Grid.Row="1" Grid.Column="6"
                             MinHeight="34"
                             ToolTip="예: 英. 비워 두면 유지, '미입력'을 입력하면 지웁니다."/>
                    <TextBox x:Name="BatchGroupTextBox"
                             Grid.Row="1" Grid.Column="8"
                             MinHeight="34"
                             ToolTip="예: リザンテクス. 비워 두면 유지, '미입력'을 입력하면 그룹을 지웁니다."/>
                    <Button Grid.Row="1" Grid.Column="10"
                            Content="체크 항목에 적용"
                            Style="{StaticResource EditorButtonStyle}"
                            Click="ApplyBatchButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="12"
                            Content="현재 표시 체크"
                            Style="{StaticResource EditorButtonStyle}"
                            Click="CheckVisibleButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="14"
                            Content="전체 체크 해제"
                            Style="{StaticResource EditorButtonStyle}"
                            Click="ClearChecksButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="#141922"
                BorderBrush="#2A3342"
                BorderThickness="1"
                CornerRadius="10"
                Padding="1">
            <DataGrid x:Name="CharacterDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowBackground="#171C26"
                      AlternatingRowBackground="#1B222D"
                      HorizontalGridLinesBrush="#293344"
                      VerticalGridLinesBrush="#293344"
                      BorderThickness="0"
                      Background="#141922"
                      Foreground="#F4F7FB"
                      RowHeight="50"
                      ColumnHeaderHeight="34"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#263142"/>
                        <Setter Property="Foreground" Value="#E8EDF5"/>
                        <Setter Property="BorderBrush" Value="#3A4658"/>
                        <Setter Property="Padding" Value="7,7"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="4,1"/>
                        <Setter Property="Foreground" Value="#F4F7FB"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="GridInlineTextBoxStyle" TargetType="TextBox">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#F4F7FB"/>
                        <Setter Property="CaretBrush" Value="#F4F7FB"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="5,3"/>
                        <Setter Property="MinHeight" Value="30"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#202734"/>
                                <Setter Property="BorderBrush" Value="#3A4658"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Background" Value="#202A37"/>
                                <Setter Property="BorderBrush" Value="#66D9EF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="#F4F7FB"/>
                        <Setter Property="MinHeight" Value="50"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#234456"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✓"
                                            Width="42"
                                            Binding="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTemplateColumn Header="일러" Width="58" IsReadOnly="True" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="42" Height="42"
                                        Background="#0F141C"
                                        BorderBrush="#3A4658"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}"
                                               Width="40"
                                               Height="40"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding ThumbnailVisibility}"
                                               SnapsToDevicePixels="True"/>
                                        <TextBlock Text="{Binding PlaceholderText}"
                                                   Foreground="#667386"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding PlaceholderVisibility}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="이름"
                                        Width="190"
                                        Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridTextColumn Header="검색 별칭"
                                        Width="180"
                                        Binding="{Binding SearchAliasesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridTextColumn Header="문자"
                                        Width="125"
                                        Binding="{Binding LettersText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridTemplateColumn Header="등급" Width="110" SortMemberPath="Category">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource GridInlineTextBoxStyle}"
                                         Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="직접 입력/붙여넣기: 스페셜, 레전드, 그랜드, 드림, 미라클, 오리지널, 콜라보, 기타"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="속성" Width="78" SortMemberPath="Attribute">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource GridInlineTextBoxStyle}"
                                         Text="{Binding Attribute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="직접 입력/붙여넣기: 火 水 木 光 闇 天 冥 虹 / 미입력"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="서브 속성"
                                        Width="105"
                                        Binding="{Binding SubAttributesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridTemplateColumn Header="종족" Width="78" SortMemberPath="Species">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource GridInlineTextBoxStyle}"
                                         Text="{Binding Species, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="직접 입력/붙여넣기: 神 魔 英 龍 獣 霊 物 妖 / 미입력"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="소속 그룹"
                                        Width="180"
                                        Binding="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridTextColumn Header="같이 취급 그룹"
                                        Width="210"
                                        Binding="{Binding IncludedGroupsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridCheckBoxColumn Header="★"
                                            Width="48"
                                            Binding="{Binding IsFavorite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridCheckBoxColumn Header="♥"
                                            Width="48"
                                            Binding="{Binding IsBeloved, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="ID"
                                        Width="230"
                                        IsReadOnly="True"
                                        Binding="{Binding Id}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#9EACBE"
                       Text="표에서 직접 수정하거나 체크 후 위의 일괄 변경을 사용하세요."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="취소"
                        Width="90"
                        Margin="0,0,8,0"
                        Style="{StaticResource EditorButtonStyle}"
                        Click="CancelButton_Click"/>
                <Button Content="변경 내용 적용"
                        Width="140"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
