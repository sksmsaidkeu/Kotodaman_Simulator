<Window x:Class="KotodamanWordFinder.CharacterBulkEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.CharBulk.Title}"
        Width="1500"
        Height="880"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ModalCardWindowStyle}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="Malgun Gothic"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="EditorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Line.Tan}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.PinkSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Bg.PanelInner}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  RecognizesAccessKey="True"/>
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource Bg.PanelInner}"
                                                        BorderBrush="{StaticResource Line.Tan}"
                                                        BorderThickness="1,0,0,0"
                                                        CornerRadius="0,6,6,0">
                                                    <Path Width="10"
                                                          Height="6"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="{StaticResource Bg.Ivory}"
                                                          Data="M 0 0 L 10 0 L 5 6 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Info.Line}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Bg.PanelInner}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Visibility="Hidden"
                                     Margin="8,2,38,2"
                                     Padding="3,0"
                                     Background="{StaticResource Chip.Dark}"
                                     Foreground="{StaticResource Text.Primary}"
                                     CaretBrush="{StaticResource Text.Primary}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Accent.PinkSoft}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_EditableTextBox" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GridEditComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <!-- 표 행 안에서 기본 39px ComboBox가 행을 덮지 않도록 전용 컴팩트 크기를 사용합니다. -->
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Info.Line}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Accent.OrangeDeep}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line.Tan}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 제목은 카드 크롬이 창의 Title 로 그립니다. 여기에는 설명만 둡니다. -->
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Text="{DynamicResource Str.CharBulk.Description}"/>
                </StackPanel>
                <TextBlock x:Name="CountText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Status.Success}"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Str.CharBulk.CountInitial}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line.Tan}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="0"
                             MinHeight="36"
                             ToolTip="{DynamicResource Str.CharBulk.SearchTooltip}"
                             TextChanged="SearchTextBox_TextChanged"/>
                    <ComboBox x:Name="CategoryFilterComboBox"
                              Grid.Column="2"
                              MinHeight="36"
                              SelectionChanged="FilterComboBox_SelectionChanged"/>
                    <ComboBox x:Name="AttributeFilterComboBox"
                              Grid.Column="4"
                              MinHeight="36"
                              SelectionChanged="FilterComboBox_SelectionChanged"/>
                    <ComboBox x:Name="SpeciesFilterComboBox"
                              Grid.Column="6"
                              MinHeight="36"
                              SelectionChanged="FilterComboBox_SelectionChanged"/>
                    <CheckBox x:Name="IncompleteOnlyCheckBox"
                              Grid.Column="7"
                              Margin="16,0,0,0"
                              Content="{DynamicResource Str.CharBulk.MissingAttrSpeciesOnly}"
                              Checked="IncompleteOnlyCheckBox_Changed"
                              Unchecked="IncompleteOnlyCheckBox_Changed"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.RowSpan="2"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Text.Secondary}"
                               Text="{DynamicResource Str.CharBulk.BulkChangeHeader}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Margin="2,0,0,4"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="11"
                               Text="{DynamicResource Str.CharBulk.CategoryLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="4"
                               Margin="2,0,0,4"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="11"
                               Text="{DynamicResource Str.CharBulk.AttributeLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="6"
                               Margin="2,0,0,4"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="11"
                               Text="{DynamicResource Str.CharBulk.SpeciesLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="8"
                               Margin="2,0,0,4"
                               Foreground="{StaticResource Accent.Focus}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="{DynamicResource Str.CharBulk.GroupLabel}"/>
                    <TextBox x:Name="BatchCategoryTextBox"
                             Grid.Row="1" Grid.Column="2"
                             MinHeight="34"
                             ToolTip="{DynamicResource Str.CharBulk.CategoryBulkTooltip}"/>
                    <TextBox x:Name="BatchAttributeTextBox"
                             Grid.Row="1" Grid.Column="4"
                             MinHeight="34"
                             ToolTip="{DynamicResource Str.CharBulk.AttributeBulkTooltip}"/>
                    <TextBox x:Name="BatchSpeciesTextBox"
                             Grid.Row="1" Grid.Column="6"
                             MinHeight="34"
                             ToolTip="{DynamicResource Str.CharBulk.SpeciesBulkTooltip}"/>
                    <TextBox x:Name="BatchGroupTextBox"
                             Grid.Row="1" Grid.Column="8"
                             MinHeight="34"
                             ToolTip="{DynamicResource Str.CharBulk.GroupBulkTooltip}"/>
                    <Button Grid.Row="1" Grid.Column="10"
                            Content="{DynamicResource Str.CharBulk.ApplyToChecked}"
                            Style="{StaticResource EditorButtonStyle}"
                            Click="ApplyBatchButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="12"
                            Content="{DynamicResource Str.CharBulk.CheckVisible}"
                            Style="{StaticResource EditorButtonStyle}"
                            Click="CheckVisibleButton_Click"/>
                    <Button Grid.Row="1" Grid.Column="14"
                            Content="{DynamicResource Str.CharBulk.UncheckAll}"
                            Style="{StaticResource EditorButtonStyle}"
                            Click="ClearChecksButton_Click"/>
                    <Button x:Name="FetchGimmickTagsButton"
                            Grid.Row="1" Grid.Column="16"
                            ToolTip="{DynamicResource Str.CharBulk.GimmickFetchTooltip}"
                            Content="{DynamicResource Str.CharBulk.GimmickFetchButton}"
                            Style="{StaticResource EditorButtonStyle}"
                            Click="FetchGimmickTagsButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line.Tan}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="1">
            <DataGrid x:Name="CharacterDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowBackground="{StaticResource Bg.Panel}"
                      AlternatingRowBackground="{StaticResource Bg.PanelInner}"
                      HorizontalGridLinesBrush="{StaticResource Line.Tan}"
                      VerticalGridLinesBrush="{StaticResource Line.Tan}"
                      BorderThickness="0"
                      Background="{StaticResource Bg.Panel}"
                      Foreground="{StaticResource Text.Primary}"
                      RowHeight="50"
                      ColumnHeaderHeight="34"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource Bg.Ivory}"/>
                        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
                        <Setter Property="Padding" Value="7,7"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="4,1"/>
                        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style x:Key="GridInlineTextBoxStyle" TargetType="TextBox">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="5,3"/>
                        <Setter Property="MinHeight" Value="30"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Bg.PanelInner}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Background" Value="{StaticResource Bg.PanelInner}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                        <Setter Property="MinHeight" Value="50"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource Info.Face}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✓"
                                            Width="42"
                                            Binding="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTemplateColumn Header="{DynamicResource Str.CharBulk.ColThumbnail}" Width="58" IsReadOnly="True" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="42" Height="42"
                                        Background="{StaticResource Bg.Backdrop}"
                                        BorderBrush="{StaticResource Line.Tan}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}"
                                               Width="40"
                                               Height="40"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding ThumbnailVisibility}"
                                               SnapsToDevicePixels="True"/>
                                        <TextBlock Text="{Binding PlaceholderText}"
                                                   Foreground="{StaticResource Text.Tertiary}"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding PlaceholderVisibility}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource Str.CharBulk.ColName}"
                                        Width="190"
                                        Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridTextColumn Header="{DynamicResource Str.CharBulk.ColAliases}"
                                        Width="180"
                                        Binding="{Binding SearchAliasesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridTextColumn Header="{DynamicResource Str.CharBulk.ColLetters}"
                                        Width="125"
                                        Binding="{Binding LettersText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridTemplateColumn Header="{DynamicResource Str.CharBulk.CategoryLabel}" Width="110" SortMemberPath="Category">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource GridInlineTextBoxStyle}"
                                         Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Str.CharBulk.ColCategoryTooltip}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{DynamicResource Str.CharBulk.AttributeLabel}" Width="78" SortMemberPath="Attribute">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource GridInlineTextBoxStyle}"
                                         Text="{Binding Attribute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Str.CharBulk.ColAttributeTooltip}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource Str.CharBulk.ColSubAttribute}"
                                        Width="105"
                                        Binding="{Binding SubAttributesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridTemplateColumn Header="{DynamicResource Str.CharBulk.SpeciesLabel}" Width="78" SortMemberPath="Species">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource GridInlineTextBoxStyle}"
                                         Text="{Binding Species, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Str.CharBulk.ColSpeciesTooltip}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource Str.CharBulk.GroupLabel}"
                                        Width="180"
                                        Binding="{Binding GroupName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridTextColumn Header="{DynamicResource Str.CharBulk.ColIncludedGroups}"
                                        Width="210"
                                        Binding="{Binding IncludedGroupsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridTextColumn Header="{DynamicResource Str.CharBulk.ColGimmickCounters}"
                                        Width="180"
                                        IsReadOnly="True"
                                        Binding="{Binding GimmickCountersText}"/>
                    <DataGridTextColumn Header="{DynamicResource Str.CharBulk.ColStatusResistances}"
                                        Width="160"
                                        IsReadOnly="True"
                                        Binding="{Binding StatusResistancesText}"/>
                    <DataGridCheckBoxColumn Header="★"
                                            Width="48"
                                            Binding="{Binding IsFavorite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridCheckBoxColumn Header="♥"
                                            Width="48"
                                            Binding="{Binding IsBeloved, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="ID"
                                        Width="230"
                                        IsReadOnly="True"
                                        Binding="{Binding Id}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusBanner" Style="{StaticResource AlertBannerStyle}" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource Text.Secondary}"
                           Text="{DynamicResource Str.CharBulk.FooterHint}"/>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Str.CharBulk.Cancel}"
                        Margin="0,0,10,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="CancelButton_Click"/>
                <Button Content="{DynamicResource Str.CharBulk.ApplyChanges}"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
