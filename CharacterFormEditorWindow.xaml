<Window x:Class="KotodamanWordFinder.CharacterFormEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="920"
        Height="620"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ModalCardWindowStyle}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="Malgun Gothic"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Line.Tan}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.PinkSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Line.Tan}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Line.Soft}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목은 카드 크롬이 창의 Title 로 그립니다(캐릭터 이름은 생성자가 Title 에 넣습니다). -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Foreground="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Text="{DynamicResource Str.CharForm.Description}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Line.Tan}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Str.CharForm.AddedFormsLabel}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox x:Name="FormListBox" Grid.Row="1" SelectionChanged="FormListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="54">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="46"
                                            Height="46"
                                            Background="{StaticResource Bg.Panel}"
                                            BorderBrush="{StaticResource Line.Tan}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}"
                                                   Visibility="{Binding ThumbnailVisibility}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Str.CharForm.NoImage}"
                                                       Visibility="{Binding PlaceholderVisibility}"
                                                       Foreground="{StaticResource Text.Tertiary}"
                                                       FontSize="8"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LettersText}" Foreground="{StaticResource Text.Secondary}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="{DynamicResource Str.CharForm.NewForm}" Margin="0,0,8,0" Click="NewFormButton_Click"/>
                        <Button Content="{DynamicResource Str.CharForm.DeleteSelected}" Background="{StaticResource Rose.Face}" BorderBrush="{StaticResource Rose.Line}" Foreground="{StaticResource Rose.Text}" Click="DeleteFormButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Line.Tan}" BorderThickness="1" CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.CharForm.NameLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,5"/>
                        <TextBox x:Name="FormNameTextBox" ToolTip="{DynamicResource Str.CharForm.NameTooltip}"/>

                        <TextBlock Text="{DynamicResource Str.CharForm.LettersLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,14,0,5"/>
                        <TextBox x:Name="FormLettersTextBox" ToolTip="{DynamicResource Str.CharForm.LettersTooltip}"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.CharForm.AttributeLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,5"/>
                                <TextBox x:Name="FormAttributeTextBox" ToolTip="{DynamicResource Str.CharForm.AttributeTooltip}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Str.CharForm.SpeciesLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,5"/>
                                <TextBox x:Name="FormSpeciesTextBox" ToolTip="{DynamicResource Str.CharForm.SpeciesTooltip}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource Str.CharForm.SubAttributeLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,10,0,5"/>
                        <TextBox x:Name="FormSubAttributesTextBox" ToolTip="{DynamicResource Str.CharForm.SubAttributeTooltip}"/>

                        <TextBlock Text="{DynamicResource Str.CharForm.NoteLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,14,0,5"/>
                        <TextBox x:Name="FormNoteTextBox" AcceptsReturn="True" Height="66" TextWrapping="Wrap" VerticalContentAlignment="Top"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="100" Height="100" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Accent.PinkSoft}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="FormImagePreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <TextBlock x:Name="FormImagePlaceholder" Text="{DynamicResource Str.CharForm.ImageNone}" Foreground="{StaticResource Text.Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.CharForm.ImageHeader}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="FormImageFileText" Foreground="{StaticResource Text.Secondary}" FontSize="11" Margin="0,4,0,8" Text="{DynamicResource Str.CharForm.NoRegisteredImage}" TextTrimming="CharacterEllipsis"/>
                                <WrapPanel>
                                    <Button Content="{DynamicResource Str.CharForm.SelectImage}" Margin="0,0,8,0" Click="ChooseImageButton_Click"/>
                                    <Button Content="{DynamicResource Str.CharForm.RemoveImage}" Background="{StaticResource Rose.Face}" BorderBrush="{StaticResource Rose.Line}" Foreground="{StaticResource Rose.Text}" Click="RemoveImageButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="ApplyFormButton" Content="{DynamicResource Str.CharForm.ApplyCurrentForm}" Margin="0,18,0,0" HorizontalAlignment="Left" Background="{StaticResource Accent.Pink}" BorderBrush="{StaticResource Accent.Pink}" Foreground="{StaticResource Text.OnAccent}" Click="ApplyFormButton_Click"/>
                        <Border x:Name="EditorStatusBanner" Style="{StaticResource AlertBannerStyle}" Margin="0,10,0,0">
                            <TextBlock x:Name="EditorStatusText" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Text="{DynamicResource Str.CharForm.SaveHint}"/>
            <WrapPanel Grid.Column="1">
                <Button Content="{DynamicResource Str.CharForm.Cancel}" Margin="0,0,10,0" Style="{StaticResource GhostButtonStyle}" Click="CancelButton_Click"/>
                <Button Content="{DynamicResource Str.CharForm.SaveAndClose}" Style="{StaticResource ActionButtonStyle}" Click="SaveButton_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
