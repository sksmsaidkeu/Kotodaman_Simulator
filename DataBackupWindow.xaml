<Window x:Class="KotodamanWordFinder.DataBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Backup.Title}"
        Width="860"
        Height="650"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ModalCardWindowStyle}"
        Foreground="{StaticResource Text.Primary}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background" Value="{StaticResource Bg.Ivory}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목은 카드 크롬이 창의 Title 로 그립니다. 여기에는 설명만 둡니다. -->
        <StackPanel Grid.Row="0">
            <TextBlock TextWrapping="Wrap"
                       Foreground="{StaticResource Text.Secondary}"
                       FontSize="13"
                       Text="{DynamicResource Str.Backup.Description}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,12"
                Padding="14,12"
                Background="{StaticResource Bg.PanelInner}"
                BorderBrush="{StaticResource Line.TanStrong}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Backup.SaveLocation}"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="BackupDirectoryText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{DynamicResource Str.Backup.OpenFolder}"
                        Margin="12,0,0,0"
                        Click="OpenBackupFolderButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="12"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line.TanStrong}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="2,0,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str.Backup.ListTitle}"
                               FontSize="17"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="BackupCountText"
                               Grid.Column="1"
                               Foreground="{StaticResource Accent.Focus}"
                               VerticalAlignment="Center"/>
                </Grid>

                <ListBox x:Name="BackupListBox"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,11"
                                    Background="{StaticResource Bg.PanelInner}"
                                    BorderBrush="{StaticResource Line.TanStrong}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding KindText}"
                                                       Foreground="{StaticResource Status.Warn}"
                                                       Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding CreatedText}"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding SizeText}"
                                                       Foreground="{StaticResource Text.Secondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Accent.Focus}"
                                               Text="{DynamicResource Str.Backup.SelectedBadge}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="2,12,2,12"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Text.Secondary}"
                   Text="{DynamicResource Str.Backup.ListHint}"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel>
                <Button x:Name="CreateBackupButton"
                        Content="{DynamicResource Str.Backup.CreateNew}"
                        Background="{StaticResource Info.Face}"
                        BorderBrush="{StaticResource Accent.Focus}"
                        Click="CreateBackupButton_Click"/>
                <Button x:Name="RestoreBackupButton"
                        Content="{DynamicResource Str.Backup.RestoreSelected}"
                        Background="{StaticResource Accent.Pink}"
                        BorderBrush="{StaticResource Accent.PinkLine}"
                        Foreground="{StaticResource Text.OnAccent}"
                        Click="RestoreBackupButton_Click"/>
                <Button x:Name="DeleteBackupButton"
                        Content="{DynamicResource Str.Backup.DeleteSelected}"
                        Background="{StaticResource Rose.Face}"
                        BorderBrush="{StaticResource Rose.Line}"
                        Click="DeleteBackupButton_Click"/>
                <Button Content="{DynamicResource Str.Backup.RefreshList}"
                        Click="RefreshButton_Click"/>
            </WrapPanel>

            <Button Grid.Column="1"
                    Content="{DynamicResource Str.Backup.Close}"
                    Margin="8,0,0,0"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
