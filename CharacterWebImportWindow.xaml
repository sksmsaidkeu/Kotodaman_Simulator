<Window x:Class="KotodamanWordFinder.CharacterWebImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.WebImport.Title}"
        Width="1080"
        Height="820"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ModalCardWindowStyle}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="Malgun Gothic">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent.Focus}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  RecognizesAccessKey="True"/>
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource Bg.PanelInner}"
                                                        BorderBrush="{StaticResource Line.Tan}"
                                                        BorderThickness="1,0,0,0"
                                                        CornerRadius="0,6,6,0">
                                                    <Path Width="10"
                                                          Height="6"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="{StaticResource Bg.Ivory}"
                                                          Data="M 0 0 L 10 0 L 5 6 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Info.Line}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Bg.PanelInner}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Visibility="Hidden"
                                     Margin="8,2,38,2"
                                     Padding="3,0"
                                     Background="{StaticResource Chip.Dark}"
                                     Foreground="{StaticResource Text.Primary}"
                                     CaretBrush="{StaticResource Text.Primary}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Accent.PinkSoft}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_EditableTextBox" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Info.Line}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Accent.OrangeDeep}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>
        <Style x:Key="ImportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Bg.Ivory}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryImportButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ImportButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Info.Face}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목은 카드 크롬이 창의 Title 로 그립니다. 여기에는 설명만 둡니다. -->
        <StackPanel>
            <TextBlock Foreground="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Text="{DynamicResource Str.WebImport.Description}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border
                    Margin="0,14,0,0"
                    Padding="13"
                    Background="{StaticResource Bg.PanelInner}"
                    BorderBrush="{StaticResource Line.TanStrong}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.WebImport.UrlLabel}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="SourceUrlTextBox"
                                 MinHeight="35"
                                 ToolTip="{DynamicResource Str.WebImport.UrlTooltip}"/>
                        <TextBlock Margin="2,6,0,0"
                                   Foreground="{StaticResource Text.Tertiary}"
                                   FontSize="11"
                                   Text="{DynamicResource Str.WebImport.AutoDetectNote}"/>
                    </StackPanel>
                    <Button x:Name="FetchButton"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Content="{DynamicResource Str.WebImport.FetchInfo}"
                            Style="{StaticResource PrimaryImportButtonStyle}"
                            Click="FetchButton_Click"/>
                </Grid>
            </Border>

            <Expander x:Name="BatchImportExpander"
                      Margin="0,10,0,0"
                      Foreground="{StaticResource Accent.Focus}"
                      FontWeight="SemiBold"
                      Header="{DynamicResource Str.WebImport.BulkHeader}"
                      IsExpanded="False">
                <Border Margin="0,8,0,0"
                        Padding="13"
                        Background="{StaticResource Bg.PanelInner}"
                        BorderBrush="{StaticResource Line.TanStrong}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource Text.Secondary}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource Str.WebImport.BulkIntro}"/>

                        <Border Margin="0,11,0,2"
                                Padding="11"
                                Background="{StaticResource Bg.Panel}"
                                BorderBrush="{StaticResource Line.TanStrong}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Status.Info}"
                                           FontWeight="SemiBold"
                                           Text="{DynamicResource Str.WebImport.ConditionSearchHeader}"/>
                                <TextBlock Margin="0,3,0,8"
                                           Foreground="{StaticResource Text.Tertiary}"
                                           FontSize="11"
                                           FontWeight="Normal"
                                           TextWrapping="Wrap"
                                           Text="{DynamicResource Str.WebImport.ConditionSearchIntro}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Text.Secondary}" Text="{DynamicResource Str.WebImport.RatingLabel}"/>
                                        <CheckBox x:Name="RatedSSSCheckBox" Margin="0,0,10,0" Content="SSS"/>
                                        <CheckBox x:Name="RatedSSCheckBox" Margin="0,0,10,0" IsChecked="True" Content="SS"/>
                                        <CheckBox x:Name="RatedSCheckBox" IsChecked="True" Content="S"/>
                                    </StackPanel>
                                    <ComboBox x:Name="RatedMatchModeComboBox" Grid.Column="2" SelectedIndex="0">
                                        <ComboBoxItem Content="{DynamicResource Str.WebImport.RatingEitherLabel}" Tag="Either"/>
                                        <ComboBoxItem Content="{DynamicResource Str.WebImport.RatingSubLabel}" Tag="SubOnly"/>
                                        <ComboBoxItem Content="{DynamicResource Str.WebImport.RatingLeaderLabel}" Tag="LeaderOnly"/>
                                        <ComboBoxItem Content="{DynamicResource Str.WebImport.RatingBothLabel}" Tag="Both"/>
                                    </ComboBox>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="RatedOriginalOnlyCheckBox" Margin="0,0,14,0" IsChecked="True" Content="{DynamicResource Str.WebImport.OriginalPriority}"/>
                                        <CheckBox x:Name="RatedExcludeRegisteredCheckBox" IsChecked="True" Content="{DynamicResource Str.WebImport.ExcludeRegistered}"/>
                                    </StackPanel>
                                    <Button x:Name="RatedDiscoverButton"
                                            Grid.Column="5"
                                            Margin="10,0,0,0"
                                            Content="{DynamicResource Str.WebImport.FindMatchingLinks}"
                                            Style="{StaticResource PrimaryImportButtonStyle}"
                                            Click="RatedDiscoverButton_Click"/>
                                </Grid>
                                <CheckBox x:Name="RatedRecentSixStarACheckBox"
                                          Margin="0,8,0,0"
                                          IsChecked="True"
                                          Content="{DynamicResource Str.WebImport.IncludeRecentAOriginal}"
                                          ToolTip="{DynamicResource Str.WebImport.IncludeRecentATooltip}"/>
                                <TextBlock x:Name="RatedSearchStatusText"
                                           Margin="0,7,0,0"
                                           Foreground="{StaticResource Text.Tertiary}"
                                           FontSize="11"
                                           FontWeight="Normal"
                                           Text="{DynamicResource Str.WebImport.DefaultConditionNote}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,10,0,5"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontWeight="Normal"
                                   Text="{DynamicResource Str.WebImport.BulkUrlLabel}"/>
                        <TextBox x:Name="BatchUrlTextBox"
                                 Height="96"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 ToolTip="{DynamicResource Str.WebImport.BulkUrlTooltip}"/>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BatchDiscoverButton"
                                    Content="{DynamicResource Str.WebImport.FindLinksFromList}"
                                    Style="{StaticResource ImportButtonStyle}"
                                    Click="BatchDiscoverButton_Click"/>
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Text.Tertiary}"
                                       FontWeight="Normal"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="{DynamicResource Str.WebImport.SkipIfIndividualOnly}"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Text.Secondary}"
                                           FontWeight="Normal"
                                           Margin="0,0,0,5"
                                           Text="{DynamicResource Str.WebImport.BulkCategoryLabel}"/>
                                <ComboBox x:Name="BatchCategoryComboBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{StaticResource Text.Secondary}"
                                           FontWeight="Normal"
                                           Margin="0,0,0,5"
                                           Text="{DynamicResource Str.WebImport.RequestIntervalLabel}"/>
                                <TextBox x:Name="BatchDelayTextBox"
                                         Text="1100"
                                         ToolTip="{DynamicResource Str.WebImport.RequestIntervalTooltip}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4"
                                        VerticalAlignment="Bottom">
                                <CheckBox x:Name="BatchUseImageCheckBox"
                                          Margin="0,0,0,9"
                                          IsChecked="True"
                                          FontWeight="Normal"
                                          Content="{DynamicResource Str.WebImport.DownloadImagesToo}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BatchStartButton"
                                    Content="{DynamicResource Str.WebImport.StartBulkFetch}"
                                    Style="{StaticResource PrimaryImportButtonStyle}"
                                    Click="BatchStartButton_Click"/>
                            <Button x:Name="BatchCancelButton"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Content="{DynamicResource Str.WebImport.Stop}"
                                    Style="{StaticResource ImportButtonStyle}"
                                    IsEnabled="False"
                                    Click="BatchCancelButton_Click"/>
                            <Button x:Name="BatchRetryFailedButton"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Content="{DynamicResource Str.WebImport.RetryFailedOnly}"
                                    Style="{StaticResource ImportButtonStyle}"
                                    IsEnabled="False"
                                    Click="BatchRetryFailedButton_Click"/>
                            <Button x:Name="BatchApplyButton"
                                    Grid.Column="4"
                                    Margin="10,0,0,0"
                                    Content="{DynamicResource Str.WebImport.RegisterSelected}"
                                    Style="{StaticResource PrimaryImportButtonStyle}"
                                    IsEnabled="False"
                                    Click="BatchApplyButton_Click"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="BatchProgressBar"
                                         Height="14"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="0"
                                         Foreground="{StaticResource Accent.Focus}"
                                         Background="{StaticResource Bg.Backdrop}"/>
                            <TextBlock x:Name="BatchProgressText"
                                       Grid.Column="1"
                                       Margin="10,-3,0,0"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontWeight="Normal"
                                       Text="0 / 0"/>
                        </Grid>

                        <TextBlock x:Name="BatchSummaryText"
                                   Margin="0,9,0,0"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontWeight="Normal"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource Str.WebImport.PasteUrlHint}"/>

                        <!-- P7: 실패 원인은 요약 문장 끝에 묻혀 있었다. 빨강 라벨 뱃지로 세운다. -->
                        <WrapPanel x:Name="BatchFailureBadgePanel" Margin="0,7,0,0" Visibility="Collapsed"/>

                        <Grid Margin="0,10,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource Status.Info}"
                                       FontWeight="SemiBold"
                                       Text="{DynamicResource Str.WebImport.ReviewTableHeader}"/>
                            <Button x:Name="BatchSelectAllButton"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="9,5"
                                    Content="{DynamicResource Str.WebImport.SelectAll}"
                                    Style="{StaticResource ImportButtonStyle}"
                                    Click="BatchSelectAllButton_Click"/>
                            <Button x:Name="BatchSelectNoneButton"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Padding="9,5"
                                    Content="{DynamicResource Str.WebImport.DeselectAll}"
                                    Style="{StaticResource ImportButtonStyle}"
                                    Click="BatchSelectNoneButton_Click"/>
                        </Grid>

                        <DataGrid x:Name="BatchReviewDataGrid"
                                  Height="235"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="{StaticResource Bg.Panel}"
                                  Foreground="{StaticResource Text.Primary}"
                                  BorderBrush="{StaticResource Line.TanStrong}"
                                  RowBackground="{StaticResource Bg.Panel}"
                                  AlternatingRowBackground="{StaticResource Bg.Panel}"
                                  HorizontalGridLinesBrush="{StaticResource Line.Tan}"
                                  VerticalGridLinesBrush="{StaticResource Line.Tan}"
                                  SelectionMode="Extended"
                                  RowHeight="54"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
                                    <Setter Property="Padding" Value="7,6"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
                                    <Setter Property="Padding" Value="5,3"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedsReview}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Alert.Face}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Alert.Text}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{DynamicResource Str.WebImport.ColRegister}"
                                                        Width="52"
                                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridCheckBoxColumn Header="{DynamicResource Str.WebImport.ColMain}"
                                                        Width="68"
                                                        Binding="{Binding IsFavorite, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridCheckBoxColumn Header="{DynamicResource Str.WebImport.ColImage}"
                                                        Width="58"
                                                        Binding="{Binding UseImage, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTemplateColumn Header="{DynamicResource Str.WebImport.ColPreview}" Width="80" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="64" Height="48" Background="{StaticResource Bg.Backdrop}" CornerRadius="4" Margin="2">
                                                <Image Source="{Binding DownloadedImagePath}" Stretch="Uniform" Margin="2"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{DynamicResource Str.WebImport.ColGwRating}"
                                                    Width="112"
                                                    IsReadOnly="True"
                                                    Binding="{Binding GameWithRatingText}"/>
                                <DataGridTextColumn Header="{DynamicResource Str.WebImport.ColStatus}"
                                                    Width="105"
                                                    IsReadOnly="True"
                                                    Binding="{Binding ReviewStatus}"/>
                                <DataGridTextColumn Header="{DynamicResource Str.WebImport.ColName}"
                                                    Width="170"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="{DynamicResource Str.WebImport.ColLetters}"
                                                    Width="150"
                                                    Binding="{Binding LettersText, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="{DynamicResource Str.WebImport.ColAttribute}"
                                                    Width="62"
                                                    Binding="{Binding Attribute, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="{DynamicResource Str.WebImport.ColSubAttribute}"
                                                    Width="90"
                                                    Binding="{Binding SubAttributesText, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="{DynamicResource Str.WebImport.ColSpecies}"
                                                    Width="62"
                                                    Binding="{Binding Species, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="{DynamicResource Str.WebImport.ColGroup}"
                                                    Width="170"
                                                    Binding="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="{DynamicResource Str.WebImport.ColIncludedGroups}"
                                                    Width="180"
                                                    Binding="{Binding IncludedGroupsText, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="{DynamicResource Str.WebImport.ColCategory}"
                                                    Width="120"
                                                    Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBox x:Name="BatchLogTextBox"
                                 Margin="0,8,0,0"
                                 Height="100"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="11"/>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="13"
                        Background="{StaticResource Bg.PanelInner}"
                        BorderBrush="{StaticResource Line.TanStrong}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="150"
                                Height="150"
                                Background="{StaticResource Bg.Backdrop}"
                                BorderBrush="{StaticResource Line.TanStrong}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="ImagePlaceholderText"
                                           Text="{DynamicResource Str.WebImport.NoImage}"
                                           Foreground="{StaticResource Text.Tertiary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Image x:Name="CharacterImagePreview"
                                       Margin="6"
                                       Stretch="Uniform"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.WebImport.NameLabel}"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="CharacterNameTextBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Str.WebImport.CategoryLabel}"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CategoryComboBox"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{DynamicResource Str.WebImport.LettersLabel}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,12,0,5"/>
                            <TextBox x:Name="LettersTextBox"
                                     ToolTip="{DynamicResource Str.WebImport.LettersTooltip}"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.WebImport.AttributeLabel}"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,5"/>
                                    <ComboBox x:Name="AttributeComboBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Str.WebImport.SubAttributeLabel}"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="SubAttributesTextBox"
                                             ToolTip="{DynamicResource Str.WebImport.SubAttributeTooltip}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{DynamicResource Str.WebImport.SpeciesLabel}"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,5"/>
                                    <ComboBox x:Name="SpeciesComboBox"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.WebImport.GroupLabel}"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,5"/>
                                    <ComboBox x:Name="GroupComboBox"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"/>
                                    <TextBlock x:Name="GroupCandidateText"
                                               Margin="2,5,0,0"
                                               Foreground="{StaticResource Text.Tertiary}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Text="{DynamicResource Str.WebImport.NoGroupCandidate}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource Str.WebImport.IncludedGroupsLabel}"
                                               Foreground="{StaticResource Text.Secondary}"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="IncludedGroupsTextBox"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="13"
                        Background="{StaticResource Bg.PanelInner}"
                        BorderBrush="{StaticResource Line.TanStrong}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.WebImport.FetchStatusLabel}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Status.Info}"/>
                        <TextBlock x:Name="SourceSummaryText"
                                   Margin="0,7,0,0"
                                   Foreground="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource Str.WebImport.EnterUrlHint}"/>
                        <CheckBox x:Name="UseImageCheckBox"
                                  Margin="0,10,0,0"
                                  IsChecked="True"
                                  Content="{DynamicResource Str.WebImport.DownloadWebImage}"/>
                        <TextBlock x:Name="ImageUrlText"
                                   Margin="20,4,0,0"
                                   Foreground="{StaticResource Text.Tertiary}"
                                   FontSize="10"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="WarningText"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource Status.Warn}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusBanner" Style="{StaticResource AlertBannerStyle}" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource Status.Success}"
                           TextWrapping="Wrap"/>
            </Border>
            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    Content="{DynamicResource Str.WebImport.Cancel}"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="CancelButton_Click"/>
            <Button x:Name="ApplyButton"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Content="{DynamicResource Str.WebImport.ImportToDetailEditor}"
                    Style="{StaticResource ActionButtonStyle}"
                    IsEnabled="False"
                    Click="ApplyButton_Click"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
