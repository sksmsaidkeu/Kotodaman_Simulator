<Window x:Class="KotodamanWordFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.AppTitle}"
        Width="1320"
        Height="900"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Backdrop}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="Malgun Gothic"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Background" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.PinkSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Accent.OrangeDeep}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- P2 스타디움 pill 탭. 선택 = 주황 면, 미선택 = 흰 면 + 탠 테두리. -->
        <Style x:Key="GeneralLengthToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}"/>
            <Setter Property="Background" Value="{StaticResource Bg.Field}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource Radius.Pill}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Accent.Orange}"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Accent.OrangeDeep}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent.Pink}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Line.Tan}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
        </Style>

        <Style x:Key="CompactButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!--
          P9 타일 그리드 카드. 게임 img1 夢幻の塔/戯言戦/育成 메뉴 타일(흰 카드 + 탠 테두리,
          위 아이콘 + 아래 라벨)을 "단어 데이터 관리" 버튼 8개에 옮긴다. 이 섹션 하나에만
          쓰이는 스타일이라 Controls.xaml(여러 창 공유)이 아니라 여기 로컬로 둔다.

          면·테두리를 트리거로 바꾸지 않는 이유: 바꾸면 그 위 아이콘/라벨 색과 다시
          짝을 맞춰야 한다(§ P7 때 6곳 사고). 호버/눌림은 테두리 링 색과 Opacity 만
          건드리고, Foreground/Background 는 항상 TemplateBinding 값 그대로 둔다.
        -->
        <Style x:Key="DataTileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="112"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Background" Value="{StaticResource Bg.Field}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileFace"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Card}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TileFace" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileFace" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileFace" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TileFace" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 8개 중 '4~6글자 순차 보충' 하나만 강조(주 액션 위계 유지). 자주 계열 3톤 한 벌. -->
        <Style x:Key="DataTilePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DataTileButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Rose.Face}"/>
            <Setter Property="Foreground" Value="{StaticResource Rose.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Rose.Line}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  RecognizesAccessKey="True"/>
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource Bg.PanelInner}"
                                                        BorderBrush="{StaticResource Line.Tan}"
                                                        BorderThickness="1,0,0,0"
                                                        CornerRadius="0,6,6,0">
                                                    <Path Width="10"
                                                          Height="6"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="{StaticResource Bg.Ivory}"
                                                          Data="M 0 0 L 10 0 L 5 6 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Info.Line}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Bg.PanelInner}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Visibility="Hidden"
                                     Margin="8,2,38,2"
                                     Padding="3,0"
                                     Background="{StaticResource Chip.Dark}"
                                     Foreground="{StaticResource Text.Primary}"
                                     CaretBrush="{StaticResource Text.Primary}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Accent.PinkSoft}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_EditableTextBox" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Info.Line}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Accent.OrangeDeep}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="20">
            <!-- 헤더는 세로로 쌓는다. 버튼 줄이 제목과 가로 폭을 다투면
                 좁은 창에서 오른쪽이 잘려 나간다(실제로 그랬다). 자기 줄을 주면
                 WrapPanel이 전체 폭을 받아 필요할 때 접힌다. -->
            <StackPanel Margin="0,0,0,14">
                <DockPanel LastChildFill="True">
                    <!-- 종료: Close()가 MainWindow_Closing을 태워 설정을 저장한다. -->
                    <Button Content="{DynamicResource Str.Exit}"
                            DockPanel.Dock="Right"
                            Width="54"
                            Height="26"
                            Padding="0"
                            FontSize="12"
                            Margin="12,0,0,0"
                            VerticalAlignment="Top"
                            ToolTip="{DynamicResource Str.ExitTooltip}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ExitButton_Click"/>
                    <!-- 언어 순환 토글: 약어(KOR/JPN/ENG)는 번역하지 않고 코드비하인드가 직접 세팅한다. -->
                    <Button x:Name="LanguageToggleButton"
                            Content="KOR"
                            DockPanel.Dock="Right"
                            Width="54"
                            Height="26"
                            Padding="0"
                            FontSize="12"
                            Margin="8,0,0,0"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="{DynamicResource Str.LanguageToggle}"
                            ToolTip="{DynamicResource Str.LanguageToggleTooltip}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="LanguageToggleButton_Click"/>
                    <!-- P6 상태 칩. 평소엔 데이터 버전, 앱 업데이트가 도는 동안엔 그 진행.
                         헤더는 이미 꽉 차 있으므로 폭을 늘리지 않는다 - 제목이 자기 몫에서
                         줄어들며(TextTrimming) 자리를 내주고, 아래 줄들은 그대로다. -->
                    <Label x:Name="StatusChip"
                           DockPanel.Dock="Right"
                           Style="{StaticResource StatusChipStyle}"
                           VerticalAlignment="Top"
                           Margin="12,0,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{DynamicResource Str.AppTitle}"
                               FontSize="27"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <TextBlock Text="{DynamicResource Str.AppDescription}"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource Text.Secondary}"
                           FontSize="13"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="DataStatsText"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource Accent.Focus}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="데이터를 불러오는 중..."/>

                <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                    <CheckBox x:Name="AutoSearchCheckBox"
                              Content="{DynamicResource Str.AutoSearch}"
                              IsChecked="True"
                              Margin="0,0,14,0"
                              Checked="AutoSearchCheckBox_Changed"
                              Unchecked="AutoSearchCheckBox_Changed"/>
                    <Button Content="{DynamicResource Str.BackupRestore}"
                            Height="44"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BackupRestoreButton_Click"/>
                    <Button Content="{DynamicResource Str.UserData}"
                            Height="44"
                            Margin="0,0,8,0"
                            ToolTip="{DynamicResource Str.UserDataTooltip}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OpenDataFolderButton_Click"/>
                    <Button Content="{DynamicResource Str.ErrorLog}"
                            Height="44"
                            Margin="0,0,8,0"
                            ToolTip="{DynamicResource Str.ErrorLogTooltip}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OpenLogFolderButton_Click"/>
                    <Button Content="{DynamicResource Str.Reload}"
                            Height="44"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ReloadDataButton_Click"/>
                    <Button Content="{DynamicResource Str.SearchNow}"
                            Width="112"
                            Height="44"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SearchButton_Click"/>
                </WrapPanel>
            </StackPanel>

            <Border Style="{StaticResource SectionBorderStyle}"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str.Board7Cells}"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="ActiveSlotText"
                                       Text="1번 칸 선택 중"
                                       Margin="12,3,0,0"
                                       Foreground="{StaticResource Accent.Focus}"/>
                        </StackPanel>

                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Str.Undo}"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="UndoBoardButton_Click"/>
                            <Button Content="{DynamicResource Str.PrevCell}"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="PreviousSlotButton_Click"/>
                            <Button Content="{DynamicResource Str.NextCell}"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="NextSlotButton_Click"/>
                            <Button Content="{DynamicResource Str.ResetBoard}"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="ClearBoardButton_Click"/>
                        </WrapPanel>
                    </Grid>

                    <UniformGrid x:Name="BoardPanel"
                                 Grid.Row="1"
                                 Columns="7"/>

                    <TextBlock x:Name="BoardHangulPreviewText"
                               Grid.Row="2"
                               Margin="2,6,0,0"
                               Foreground="{StaticResource Text.Tertiary}"
                               FontSize="10"
                               Text="빠른 입력에 한글을 입력하면 가나로 자동 변환됩니다."/>

                    <Grid Grid.Row="3" Margin="5,12,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{DynamicResource Str.QuickInput}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="QuickBoardInputTextBox"
                                 Grid.Column="1"
                                 MaxLength="24"
                                 ToolTip="{DynamicResource Str.QuickInputExample}"
                                 TextChanged="QuickBoardInputTextBox_TextChanged"
                                 KeyDown="QuickBoardInputTextBox_KeyDown"/>
                        <Button Grid.Column="2"
                                Content="{DynamicResource Str.Apply}"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ApplyQuickBoardInputButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Expander x:Name="GeneralSuggestionExpander"
                      IsExpanded="False"
                      Margin="0,0,0,12"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Foreground="{StaticResource Text.Primary}">
                <Expander.Header>
                    <Border Padding="14,10"
                            HorizontalAlignment="Stretch"
                            Background="{StaticResource Bg.PanelInner}"
                            BorderBrush="{StaticResource Line.TanStrong}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="GeneralSuggestionTitleText"
                                           Text="일반 문자 검색 · 판면을 입력하면 손패와 관계없이 자동 검색"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Accent.Focus}"/>
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource Text.Tertiary}"
                                           Text="{DynamicResource Str.ExpandCollapseHint}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Status.Info}"
                                       Text="{DynamicResource Str.ExpandCollapse}"/>
                        </Grid>
                    </Border>
                </Expander.Header>
                <Border Margin="0,6,0,0"
                        Padding="14,12"
                        Background="{StaticResource Bg.Panel}"
                        BorderBrush="{StaticResource Line.TanStrong}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <ToggleButton x:Name="GeneralLength7Toggle"
                                          Content="{DynamicResource Str.Len7}"
                                          Tag="7"
                                          IsChecked="True"
                                          Margin="0,0,8,6"
                                          Style="{StaticResource GeneralLengthToggleStyle}"
                                          Click="GeneralSuggestionLengthToggle_Click"/>
                            <ToggleButton x:Name="GeneralLength6Toggle"
                                          Content="{DynamicResource Str.Len6}"
                                          Tag="6"
                                          Margin="0,0,8,6"
                                          Style="{StaticResource GeneralLengthToggleStyle}"
                                          Click="GeneralSuggestionLengthToggle_Click"/>
                            <ToggleButton x:Name="GeneralLength5Toggle"
                                          Content="{DynamicResource Str.Len5}"
                                          Tag="5"
                                          Margin="0,0,8,6"
                                          Style="{StaticResource GeneralLengthToggleStyle}"
                                          Click="GeneralSuggestionLengthToggle_Click"/>
                            <ToggleButton x:Name="GeneralLength4Toggle"
                                          Content="{DynamicResource Str.Len4}"
                                          Tag="4"
                                          Margin="0,0,0,6"
                                          Style="{StaticResource GeneralLengthToggleStyle}"
                                          Click="GeneralSuggestionLengthToggle_Click"/>
                        </WrapPanel>
                        <Grid>
                            <DataGrid x:Name="GeneralSuggestionWordsGrid"
                                      Visibility="Collapsed"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource Line.TanStrong}"
                                      VerticalGridLinesBrush="{StaticResource Line.TanStrong}"
                                      Background="{StaticResource Bg.Panel}"
                                      Foreground="{StaticResource Text.Primary}"
                                      BorderBrush="{StaticResource Line.TanStrong}"
                                      BorderThickness="1"
                                      RowBackground="{StaticResource Bg.PanelInner}"
                                      AlternatingRowBackground="{StaticResource Bg.Panel}"
                                      AlternationCount="2"
                                      RowHeight="31"
                                      ColumnHeaderHeight="34"
                                      MaxHeight="310"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="44"/>
                                    <DataGridTextColumn Header="{DynamicResource Str.ColWord}" Binding="{Binding Word}" Width="2*"/>
                                    <DataGridTextColumn Header="{DynamicResource Str.ColRequiredChars}" Binding="{Binding RequiredLetters}" Width="1.7*"/>
                                    <DataGridTextColumn Header="{DynamicResource Str.ColCombo}" Binding="{Binding ComboCount}" Width="64"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="GeneralSuggestionEmptyText"
                                       Text="판면 문자를 하나 이상 입력하면 일반 검색 결과가 표시됩니다."
                                       FontSize="13"
                                       Foreground="{StaticResource Text.Secondary}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>

            <Border Style="{StaticResource SectionBorderStyle}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.CharacterInputHint}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,10"/>
                    <StackPanel x:Name="BasicKanaPanel" Margin="0,0,0,10"/>
                    <StackPanel x:Name="VoicedKanaPanel" Margin="0,0,0,10"/>
                    <StackPanel x:Name="SmallKanaPanel"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str.CurrentHand4}"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="HandCountText"
                                       Text="0 / 4 선택"
                                       Margin="12,3,0,0"
                                       Foreground="{StaticResource Accent.Focus}"/>
                            <Border Margin="12,0,0,0"
                                    Padding="6,2"
                                    Background="{StaticResource Special.Face}"
                                    BorderBrush="{StaticResource Special.Line}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <TextBlock Text="MS · 이미지 2.2초 길게 눌러 전환"
                                           FontSize="10"
                                           Foreground="{StaticResource Status.Special}"/>
                            </Border>
                        </StackPanel>

                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Content="{DynamicResource Str.CharacterListDeck}"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="EditDeckButton_Click"/>
                            <Button Content="{DynamicResource Str.ResetHand}"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="ClearHandButton_Click"/>
                        </WrapPanel>

                        <Border Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                Padding="10,8"
                                Background="{StaticResource Bg.PanelInner}"
                                BorderBrush="{StaticResource Line.TanStrong}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str.DeckPreset}"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Accent.Focus}"/>
                                <ComboBox x:Name="MainPresetComboBox"
                                          Grid.Column="1"
                                          MaxDropDownHeight="320"
                                          HorizontalContentAlignment="Stretch"
                                          SelectionChanged="MainPresetComboBox_SelectionChanged"
                                          ToolTip="{DynamicResource Str.DeckPresetTooltip}"/>
                                <Button Grid.Column="2"
                                        Content="{DynamicResource Str.ChangeToThisDeck}"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Click="ApplyMainPresetButton_Click"/>
                                <TextBlock x:Name="MainPresetStatusText"
                                           Grid.Column="3"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Text.Secondary}"
                                           FontSize="11"
                                           Text="{DynamicResource Str.PresetChangeHint}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MiracleLeaderStatusText"
                                           Grid.Row="1"
                                           Grid.ColumnSpan="4"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource Status.Special}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="리더 효과를 확인하는 중..."/>
                            </Grid>
                        </Border>
                    </Grid>

                    <UniformGrid x:Name="SelectedHandPanel"
                                 Grid.Row="1"
                                 Columns="4"
                                 Margin="0,0,0,10"/>

                    <WrapPanel x:Name="DeckCharacterPanel"
                               Grid.Row="2"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}"
                    Margin="0,0,0,12"
                    Padding="14,11">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.ResultLengthSelect}"
                               FontSize="15"
                               FontWeight="Bold"/>
                    <TextBlock Text="{DynamicResource Str.ResultLengthHint}"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource Text.Secondary}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        MinHeight="320"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="HandResultsTitleText"
                                   Text="{DynamicResource Str.HandResultsTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>
                        <StackPanel x:Name="HandResultsPanel"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        MinHeight="320"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.DeckResultsTitle}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.Sort}"
                                           Margin="0,0,7,0"
                                           Foreground="{StaticResource Text.Secondary}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="DeckResultSortComboBox"
                                          Width="150"
                                          ToolTip="{DynamicResource Str.PracticalRecommendTooltip}"
                                          SelectionChanged="DeckResultSortComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="Practical" Content="{DynamicResource Str.PracticalRecommend}"/>
                                    <ComboBoxItem Tag="Probability" Content="{DynamicResource Str.FirstTurnRate}"/>
                                    <ComboBoxItem Tag="Combo" Content="{DynamicResource Str.ExpectedCombo}"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="DeckResultsPanel"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource SectionBorderStyle}"
                    Margin="0,0,0,12"
                    Padding="14">
                <Expander IsExpanded="False"
                          Foreground="{StaticResource Text.Primary}">
                    <Expander.Header>
                        <StackPanel Margin="0,1,0,1">
                            <TextBlock Text="{DynamicResource Str.WordDataManagement}"
                                       FontWeight="Bold"
                                       FontSize="16"/>
                            <TextBlock x:Name="DictionaryUpdateText"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource Accent.Focus}"
                                       TextWrapping="Wrap"
                                       Text="아직 GACCAG 데이터를 내려받지 않았습니다."/>
                        </StackPanel>
                    </Expander.Header>

                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- P9 타일 그리드. 8칸 고정폭 타일이라 UniformGrid 4열이 그대로 격자를 이룬다. -->
                        <UniformGrid Grid.Row="0"
                                     Columns="4"
                                     HorizontalAlignment="Left">
                            <Button Style="{StaticResource DataTileButtonStyle}"
                                    Click="OpenGaccagSiteButton_Click"
                                    AutomationProperties.Name="{DynamicResource Str.OpenGaccagSite}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="30" Height="30">
                                        <Ellipse Width="20" Height="20"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Stroke="{StaticResource Text.Primary}"
                                                 StrokeThickness="1.8"/>
                                        <Path Data="M8,19 L19,8 M10,8 L19,8 L19,17"
                                              Stretch="None"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{StaticResource Text.Primary}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Str.OpenGaccagSite}"
                                               Margin="0,8,0,0" FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Width="118" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="CancelGaccagUpdateButton"
                                    Style="{StaticResource DataTileButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="CancelGaccagUpdateButton_Click"
                                    AutomationProperties.Name="{DynamicResource Str.CancelUpdate}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="30" Height="30">
                                        <Rectangle Width="16" Height="16" RadiusX="2" RadiusY="2"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Fill="{StaticResource Alert.Text}"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Str.CancelUpdate}"
                                               Margin="0,8,0,0" FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Width="118" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="UpdateComboWordsButton"
                                    Style="{StaticResource DataTileButtonStyle}"
                                    Click="UpdateComboWordsButton_Click"
                                    AutomationProperties.Name="{DynamicResource Str.CollectComboData}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="30" Height="30">
                                        <Ellipse Canvas.Left="2" Canvas.Top="2" Width="13" Height="13"
                                                 Stroke="{StaticResource Text.Primary}" StrokeThickness="1.6"/>
                                        <Line X1="11" Y1="11" X2="15" Y2="15"
                                              Stroke="{StaticResource Text.Primary}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M22,12 L22,20 M18,17 L22,21 L26,17 M17,24 L27,24"
                                              Stroke="{StaticResource Text.Primary}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                    <TextBlock Text="{DynamicResource Str.CollectComboData}"
                                               Margin="0,8,0,0" FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Width="118" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="UpdateFourLetterButton"
                                    Style="{StaticResource DataTileButtonStyle}"
                                    Click="UpdateFourLetterButton_Click"
                                    AutomationProperties.Name="{DynamicResource Str.Fill4}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{StaticResource Bg.Field}"
                                            BorderBrush="{StaticResource Line.TanStrong}"
                                            BorderThickness="2">
                                        <TextBlock Text="4" FontWeight="Bold" FontSize="15"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Str.Fill4}"
                                               Margin="0,8,0,0" FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Width="118" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="UpdateFiveLetterButton"
                                    Style="{StaticResource DataTileButtonStyle}"
                                    Click="UpdateFiveLetterButton_Click"
                                    AutomationProperties.Name="{DynamicResource Str.Fill5}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{StaticResource Bg.Field}"
                                            BorderBrush="{StaticResource Line.TanStrong}"
                                            BorderThickness="2">
                                        <TextBlock Text="5" FontWeight="Bold" FontSize="15"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Str.Fill5}"
                                               Margin="0,8,0,0" FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Width="118" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="UpdateSixLetterButton"
                                    Style="{StaticResource DataTileButtonStyle}"
                                    Click="UpdateSixLetterButton_Click"
                                    AutomationProperties.Name="{DynamicResource Str.Fill6}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{StaticResource Bg.Field}"
                                            BorderBrush="{StaticResource Line.TanStrong}"
                                            BorderThickness="2">
                                        <TextBlock Text="6" FontWeight="Bold" FontSize="15"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Str.Fill6}"
                                               Margin="0,8,0,0" FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Width="118" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="UpdateSevenLetterButton"
                                    Style="{StaticResource DataTileButtonStyle}"
                                    Click="UpdateSevenLetterButton_Click"
                                    AutomationProperties.Name="{DynamicResource Str.Recheck7}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="{StaticResource Bg.Field}"
                                            BorderBrush="{StaticResource Line.TanStrong}"
                                            BorderThickness="2">
                                        <TextBlock Text="7" FontWeight="Bold" FontSize="15"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Str.Recheck7}"
                                               Margin="0,8,0,0" FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Width="118" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="UpdateSearchWordsButton"
                                    Style="{StaticResource DataTilePrimaryButtonStyle}"
                                    Click="UpdateSearchWordsButton_Click"
                                    AutomationProperties.Name="{DynamicResource Str.SequentialFill}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="30" Height="30">
                                        <Path Data="M4,4 L15,10 L26,4 M4,12 L15,18 L26,12 M4,20 L15,26 L26,20"
                                              Stretch="None"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{StaticResource Rose.Text}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Str.SequentialFill}"
                                               Margin="0,8,0,0" FontSize="12" FontWeight="Bold"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Width="118" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <ProgressBar x:Name="DictionaryUpdateProgressBar"
                                     Grid.Row="1"
                                     Height="8"
                                     Margin="0,4,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Visibility="Collapsed"/>

                        <TextBlock x:Name="DictionaryUpdateProgressText"
                                   Grid.Row="2"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource Text.Primary}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>

                        <TextBlock Grid.Row="3"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource Str.DataUsageHint}"/>
                    </Grid>
                </Expander>
            </Border>

            <TextBlock x:Name="StatusText"
                       Margin="4,0,4,20"
                       Foreground="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Text="판면을 입력하고 덱 캐릭터 버튼을 눌러 현재 손패를 선택하세요."/>
        </StackPanel>
    </ScrollViewer>
</Window>
