<Window x:Class="KotodamanWordFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="코토다망 최장 단어 탐색기"
        Width="1320"
        Height="900"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#10131A"
        Foreground="#F4F7FB"
        FontFamily="Malgun Gothic"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#171C26"/>
            <Setter Property="BorderBrush" Value="#2A3342"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#2A3342"/>
            <Setter Property="BorderBrush" Value="#46546A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#324052"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#66D9EF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4051"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8BE8F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GeneralLengthToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#DCE8F0"/>
            <Setter Property="Background" Value="#243240"/>
            <Setter Property="BorderBrush" Value="#3E5A70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#66D9EF"/>
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#2B4050"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#245E88"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#66D9EF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4B8BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#2A3342"/>
            <Setter Property="Foreground" Value="#E8EDF5"/>
        </Style>

        <Style x:Key="CompactButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#222A37"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="CaretBrush" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#3A4658"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D7DEEA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#222A37"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#3A4658"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  RecognizesAccessKey="True"/>
                                                <Border Grid.Column="1"
                                                        Background="#1B222D"
                                                        BorderBrush="#3A4658"
                                                        BorderThickness="1,0,0,0"
                                                        CornerRadius="0,6,6,0">
                                                    <Path Width="10"
                                                          Height="6"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="#C8D1DE"
                                                          Data="M 0 0 L 10 0 L 5 6 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#293442"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#547086"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#263746"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#66D9EF"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Visibility="Hidden"
                                     Margin="8,2,38,2"
                                     Padding="3,0"
                                     Background="#222A37"
                                     Foreground="#F4F7FB"
                                     CaretBrush="#F4F7FB"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#171C26"
                                        BorderBrush="#46546A"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_EditableTextBox" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#222A37"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#29465A"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#547086"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4051"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#66D9EF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#718096"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="20">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="코토다망 최장 단어 탐색기"
                               FontSize="27"
                               FontWeight="Bold"/>
                    <TextBlock Text="최장 단어를 먼저 찾고, 같은 글자 수에서는 예상 콤보가 높은 후보부터 보여줍니다. 콤보는 이번에 배치하는 캐릭터 문자가 하나 이상 들어간 단어만 계산합니다."
                               Margin="0,5,0,0"
                               Foreground="#AEB8C8"
                               FontSize="13"/>
                    <TextBlock x:Name="DataStatsText"
                               Margin="0,5,0,0"
                               Foreground="#66D9EF"
                               FontSize="12"
                               Text="데이터를 불러오는 중..."/>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    <CheckBox x:Name="AutoSearchCheckBox"
                              Content="자동 검색"
                              IsChecked="True"
                              Margin="0,0,14,0"
                              Checked="AutoSearchCheckBox_Changed"
                              Unchecked="AutoSearchCheckBox_Changed"/>
                    <Button Content="백업 / 복원"
                            Height="44"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BackupRestoreButton_Click"/>
                    <Button Content="사용자 데이터"
                            Height="44"
                            Margin="0,0,8,0"
                            ToolTip="실제로 수정·저장되는 사용자 데이터 폴더를 엽니다."
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OpenDataFolderButton_Click"/>
                    <Button Content="오류 로그"
                            Height="44"
                            Margin="0,0,8,0"
                            ToolTip="프로그램 오류와 실행 기록이 저장되는 로그 폴더를 엽니다."
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OpenLogFolderButton_Click"/>
                    <Button Content="다시 읽기"
                            Height="44"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ReloadDataButton_Click"/>
                    <Button Content="지금 검색"
                            Width="112"
                            Height="44"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="SearchButton_Click"/>
                </WrapPanel>
            </Grid>

            <Border Style="{StaticResource SectionBorderStyle}"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="판면 7칸"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="ActiveSlotText"
                                       Text="1번 칸 선택 중"
                                       Margin="12,3,0,0"
                                       Foreground="#66D9EF"/>
                        </StackPanel>

                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Content="되돌리기"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="UndoBoardButton_Click"/>
                            <Button Content="이전 칸"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="PreviousSlotButton_Click"/>
                            <Button Content="다음 칸"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="NextSlotButton_Click"/>
                            <Button Content="판면 초기화"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="ClearBoardButton_Click"/>
                        </WrapPanel>
                    </Grid>

                    <UniformGrid x:Name="BoardPanel"
                                 Grid.Row="1"
                                 Columns="7"/>

                    <TextBlock x:Name="BoardHangulPreviewText"
                               Grid.Row="2"
                               Margin="2,6,0,0"
                               Foreground="#718096"
                               FontSize="10"
                               Text="빠른 입력에 한글을 입력하면 가나로 자동 변환됩니다."/>

                    <Grid Grid.Row="3" Margin="5,12,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="빠른 입력"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="QuickBoardInputTextBox"
                                 Grid.Column="1"
                                 MaxLength="24"
                                 ToolTip="예: _ゅう_くせい 또는 □ゅう□くせい · 띄어쓰기는 빈칸"
                                 TextChanged="QuickBoardInputTextBox_TextChanged"
                                 KeyDown="QuickBoardInputTextBox_KeyDown"/>
                        <Button Grid.Column="2"
                                Content="적용"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ApplyQuickBoardInputButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <Expander x:Name="GeneralSuggestionExpander"
                      IsExpanded="False"
                      Margin="0,0,0,12"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Foreground="#F4F7FB">
                <Expander.Header>
                    <Border Padding="14,10"
                            HorizontalAlignment="Stretch"
                            Background="#172532"
                            BorderBrush="#315A70"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="GeneralSuggestionTitleText"
                                           Text="일반 문자 검색 · 판면을 입력하면 손패와 관계없이 자동 검색"
                                           FontWeight="Bold"
                                           Foreground="#66D9EF"/>
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="#7F95A8"
                                           Text="클릭해서 펼치기 / 접기 · 7~4글자를 토글해서 확인"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#9FC5D8"
                                       Text="펼치기 / 접기"/>
                        </Grid>
                    </Border>
                </Expander.Header>
                <Border Margin="0,6,0,0"
                        Padding="14,12"
                        Background="#121E28"
                        BorderBrush="#315A70"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <ToggleButton x:Name="GeneralLength7Toggle"
                                          Content="7글자"
                                          Tag="7"
                                          IsChecked="True"
                                          Margin="0,0,8,6"
                                          Padding="12,7"
                                          Style="{StaticResource GeneralLengthToggleStyle}"
                                          Click="GeneralSuggestionLengthToggle_Click"/>
                            <ToggleButton x:Name="GeneralLength6Toggle"
                                          Content="6글자"
                                          Tag="6"
                                          Margin="0,0,8,6"
                                          Padding="12,7"
                                          Style="{StaticResource GeneralLengthToggleStyle}"
                                          Click="GeneralSuggestionLengthToggle_Click"/>
                            <ToggleButton x:Name="GeneralLength5Toggle"
                                          Content="5글자"
                                          Tag="5"
                                          Margin="0,0,8,6"
                                          Padding="12,7"
                                          Style="{StaticResource GeneralLengthToggleStyle}"
                                          Click="GeneralSuggestionLengthToggle_Click"/>
                            <ToggleButton x:Name="GeneralLength4Toggle"
                                          Content="4글자"
                                          Tag="4"
                                          Margin="0,0,0,6"
                                          Padding="12,7"
                                          Style="{StaticResource GeneralLengthToggleStyle}"
                                          Click="GeneralSuggestionLengthToggle_Click"/>
                        </WrapPanel>
                        <Grid>
                            <DataGrid x:Name="GeneralSuggestionWordsGrid"
                                      Visibility="Collapsed"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#2E4353"
                                      VerticalGridLinesBrush="#2E4353"
                                      Background="#111A23"
                                      Foreground="#EAF7FB"
                                      BorderBrush="#315A70"
                                      BorderThickness="1"
                                      RowBackground="#182530"
                                      AlternatingRowBackground="#14202A"
                                      AlternationCount="2"
                                      RowHeight="31"
                                      ColumnHeaderHeight="34"
                                      MaxHeight="310"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#213747"/>
                                        <Setter Property="Foreground" Value="#BFEAF4"/>
                                        <Setter Property="BorderBrush" Value="#315A70"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="#EAF7FB"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="44"/>
                                    <DataGridTextColumn Header="단어" Binding="{Binding Word}" Width="2*"/>
                                    <DataGridTextColumn Header="필요 문자" Binding="{Binding RequiredLetters}" Width="1.7*"/>
                                    <DataGridTextColumn Header="콤보" Binding="{Binding ComboCount}" Width="64"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="GeneralSuggestionEmptyText"
                                       Text="판면 문자를 하나 이상 입력하면 일반 검색 결과가 표시됩니다."
                                       FontSize="13"
                                       Foreground="#9FB2C2"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>

            <Border Style="{StaticResource SectionBorderStyle}"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="문자 입력 — 판면 칸을 누른 뒤 문자를 선택하면 다음 칸으로 자동 이동합니다"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,10"/>
                    <StackPanel x:Name="BasicKanaPanel" Margin="0,0,0,10"/>
                    <StackPanel x:Name="VoicedKanaPanel" Margin="0,0,0,10"/>
                    <StackPanel x:Name="SmallKanaPanel"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="현재 손패 4명"
                                       FontSize="17"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="HandCountText"
                                       Text="0 / 4 선택"
                                       Margin="12,3,0,0"
                                       Foreground="#66D9EF"/>
                            <Border Margin="12,0,0,0"
                                    Padding="6,2"
                                    Background="#2C2440"
                                    BorderBrush="#66528C"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <TextBlock Text="MS · 이미지 2.2초 길게 눌러 전환"
                                           FontSize="10"
                                           Foreground="#D9C2FF"/>
                            </Border>
                        </StackPanel>

                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Content="캐릭터 목록 / 덱 편성"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="EditDeckButton_Click"/>
                            <Button Content="손패 초기화"
                                    Style="{StaticResource CompactButtonStyle}"
                                    Click="ClearHandButton_Click"/>
                        </WrapPanel>

                        <Border Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                Padding="10,8"
                                Background="#1B2633"
                                BorderBrush="#30465A"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="덱 프리셋"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="#66D9EF"/>
                                <ComboBox x:Name="MainPresetComboBox"
                                          Grid.Column="1"
                                          MaxDropDownHeight="320"
                                          HorizontalContentAlignment="Stretch"
                                          SelectionChanged="MainPresetComboBox_SelectionChanged"
                                          ToolTip="저장된 덱 프리셋 선택"/>
                                <Button Grid.Column="2"
                                        Content="이 덱으로 변경"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource CompactButtonStyle}"
                                        Click="ApplyMainPresetButton_Click"/>
                                <TextBlock x:Name="MainPresetStatusText"
                                           Grid.Column="3"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#8FA0B4"
                                           FontSize="11"
                                           Text="프리셋을 선택하면 현재 덱 12명이 교체됩니다."
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MiracleLeaderStatusText"
                                           Grid.Row="1"
                                           Grid.ColumnSpan="4"
                                           Margin="0,8,0,0"
                                           Foreground="#CDB7FF"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="리더 효과를 확인하는 중..."/>
                            </Grid>
                        </Border>
                    </Grid>

                    <UniformGrid x:Name="SelectedHandPanel"
                                 Grid.Row="1"
                                 Columns="4"
                                 Margin="0,0,0,10"/>

                    <WrapPanel x:Name="DeckCharacterPanel"
                               Grid.Row="2"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionBorderStyle}"
                    Margin="0,0,0,12"
                    Padding="14,11">
                <StackPanel>
                    <TextBlock Text="결과 길이 선택"
                               FontSize="15"
                               FontWeight="Bold"/>
                    <TextBlock Text="검색은 7·6·5·4글자를 한 번에 계산합니다. 아래 각 결과 영역의 길이 버튼으로 원하는 후보를 바로 전환할 수 있습니다."
                               Margin="0,4,0,0"
                               Foreground="#8FA0B4"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        MinHeight="320"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="HandResultsTitleText"
                                   Text="현재 손패로 가능"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>
                        <StackPanel x:Name="HandResultsPanel"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        MinHeight="320"
                        Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="덱 전체에서 가능"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="정렬"
                                           Margin="0,0,7,0"
                                           Foreground="#8FA0B4"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="DeckResultSortComboBox"
                                          Width="150"
                                          ToolTip="실전 추천 = 예상 콤보 × 첫 턴 성립률 · 첫 턴은 리더 고정 + 나머지 6명 기준"
                                          SelectionChanged="DeckResultSortComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="Practical" Content="실전 추천"/>
                                    <ComboBoxItem Tag="Probability" Content="첫 턴 성립률"/>
                                    <ComboBoxItem Tag="Combo" Content="예상 콤보"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="DeckResultsPanel"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource SectionBorderStyle}"
                    Margin="0,0,0,12"
                    Padding="14">
                <Expander IsExpanded="False"
                          Foreground="#F4F7FB">
                    <Expander.Header>
                        <StackPanel Margin="0,1,0,1">
                            <TextBlock Text="단어 데이터 관리"
                                       FontWeight="Bold"
                                       FontSize="16"/>
                            <TextBlock x:Name="DictionaryUpdateText"
                                       Margin="0,4,0,0"
                                       Foreground="#66D9EF"
                                       TextWrapping="Wrap"
                                       Text="아직 GACCAG 데이터를 내려받지 않았습니다."/>
                        </StackPanel>
                    </Expander.Header>

                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center">
                            <Button Content="GACCAG 사이트 열기"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenGaccagSiteButton_Click"/>
                            <Button x:Name="CancelGaccagUpdateButton"
                                    Content="업데이트 중단"
                                    Margin="0,0,8,8"
                                    Visibility="Collapsed"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="CancelGaccagUpdateButton_Click"/>
                            <Button x:Name="UpdateComboWordsButton"
                                    Content="2~3글자 콤보 데이터 수집"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="UpdateComboWordsButton_Click"/>
                            <Button x:Name="UpdateFourLetterButton"
                                    Content="4글자 보충"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="UpdateFourLetterButton_Click"/>
                            <Button x:Name="UpdateFiveLetterButton"
                                    Content="5글자 보충"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="UpdateFiveLetterButton_Click"/>
                            <Button x:Name="UpdateSixLetterButton"
                                    Content="6글자 보충"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="UpdateSixLetterButton_Click"/>
                            <Button x:Name="UpdateSevenLetterButton"
                                    Content="7글자 재검사"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="UpdateSevenLetterButton_Click"/>
                            <Button x:Name="UpdateSearchWordsButton"
                                    Content="4~6글자 순차 보충"
                                    Margin="0,0,0,8"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="UpdateSearchWordsButton_Click"/>
                        </WrapPanel>

                        <ProgressBar x:Name="DictionaryUpdateProgressBar"
                                     Grid.Row="1"
                                     Height="8"
                                     Margin="0,4,0,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Visibility="Collapsed"/>

                        <TextBlock x:Name="DictionaryUpdateProgressText"
                                   Grid.Row="2"
                                   Margin="0,8,0,0"
                                   Foreground="#D7DEEA"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>

                        <TextBlock Grid.Row="3"
                                   Margin="0,8,0,0"
                                   Foreground="#AEB8C8"
                                   TextWrapping="Wrap"
                                   Text="현재 4~7글자 데이터는 최장 단어 검색에 사용됩니다. 2~3글자 데이터는 캐릭터 문자가 포함된 연속 단어의 예상 콤보 계산에 사용됩니다."/>
                    </Grid>
                </Expander>
            </Border>

            <TextBlock x:Name="StatusText"
                       Margin="4,0,4,20"
                       Foreground="#AEB8C8"
                       TextWrapping="Wrap"
                       Text="판면을 입력하고 덱 캐릭터 버튼을 눌러 현재 손패를 선택하세요."/>
        </StackPanel>
    </ScrollViewer>
</Window>
