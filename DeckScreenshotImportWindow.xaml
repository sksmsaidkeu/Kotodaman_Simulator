<Window x:Class="KotodamanWordFinder.DeckScreenshotImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Screenshot.Title}"
        Width="1240"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ModalCardWindowStyle}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent.Pink}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.PinkLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Bg.Ivory}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Info.Face}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkChoiceComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{StaticResource Bg.Panel}"
                                                BorderBrush="{StaticResource Line.TanStrong}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="9,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Foreground="{StaticResource Text.Primary}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="{StaticResource Text.Secondary}"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Line.Soft}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="360"
                                        Margin="0,3,0,0"
                                        Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Line.Soft}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목은 카드 크롬이 창의 Title 로 그립니다. 여기에는 설명만 둡니다. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Foreground="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Text="{DynamicResource Str.Screenshot.Description}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="12"
                Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Line.TanStrong}"
                BorderThickness="1"
                CornerRadius="10">
            <WrapPanel>
                <Button Content="{DynamicResource Str.Screenshot.SelectScreenshot}"
                        Margin="0,0,8,8"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ChooseScreenshotButton_Click"/>
                <Button Content="{DynamicResource Str.Screenshot.PasteClipboard}"
                        Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="{DynamicResource Str.Screenshot.PasteClipboardTooltip}"
                        Click="PasteScreenshotButton_Click"/>
                <Button Content="{DynamicResource Str.Screenshot.AutoDetectRegion}"
                        Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="GuessGridButton_Click"/>
                <Button Content="{DynamicResource Str.Screenshot.UseFullImage4x3}"
                        Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="UseFullImageButton_Click"/>
                <Button x:Name="RecognizeButton"
                        Content="{DynamicResource Str.Screenshot.StartRecognition}"
                        Margin="0,0,8,8"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="RecognizeButton_Click"/>
                <CheckBox x:Name="UseLearnedSamplesCheckBox"
                          Content="{DynamicResource Str.Screenshot.UseLearningSamples}"
                          IsChecked="True"
                          Margin="8,7,10,8"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource Status.Success}"
                          ToolTip="{DynamicResource Str.Screenshot.UseLearningSamplesTooltip}"/>
                <CheckBox x:Name="UseAttributeColorAssistCheckBox"
                          Content="{DynamicResource Str.Screenshot.UseAttributeColorAssist}"
                          IsChecked="True"
                          Margin="0,7,10,8"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource Status.Info}"
                          ToolTip="{DynamicResource Str.Screenshot.UseAttributeColorAssistTooltip}"/>
                <CheckBox x:Name="LearnVerifiedSamplesCheckBox"
                          Content="{DynamicResource Str.Screenshot.LearnFromReview}"
                          IsChecked="True"
                          Margin="0,7,10,8"
                          VerticalAlignment="Center"
                          Foreground="{StaticResource Status.Success}"
                          ToolTip="{DynamicResource Str.Screenshot.LearnFromReviewTooltip}"/>
                <Button Content="{DynamicResource Str.Screenshot.ResetCurrentUiLearning}"
                        Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="{DynamicResource Str.Screenshot.ResetCurrentUiLearningTooltip}"
                        Click="ClearLearningButton_Click"/>
                <TextBlock x:Name="LearningStatusText"
                           Margin="8,8,12,8"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Status.Success}"
                           FontSize="11"
                           Text="{DynamicResource Str.Screenshot.CheckingLearningProfile}"/>
                <TextBlock x:Name="SelectionInfoText"
                           Margin="8,8,0,0"
                           Foreground="{StaticResource Text.Secondary}"
                           Text="{DynamicResource Str.Screenshot.SelectScreenshotFirst}"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Bg.Backdrop}"
                    BorderBrush="{StaticResource Line.TanStrong}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">
                <Grid x:Name="PreviewHost"
                      Background="{StaticResource Bg.Backdrop}"
                      MouseLeftButtonDown="PreviewHost_MouseLeftButtonDown"
                      MouseMove="PreviewHost_MouseMove"
                      MouseLeftButtonUp="PreviewHost_MouseLeftButtonUp">
                    <Image x:Name="ScreenshotPreviewImage"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"/>
                    <Canvas x:Name="SelectionCanvas"
                            IsHitTestVisible="False"/>
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10"
                            Padding="8,5"
                            CornerRadius="6"
                            Background="{StaticResource Overlay.Scrim}">
                        <TextBlock Foreground="{StaticResource Text.Primary}"
                                   FontSize="11"
                                   Text="{DynamicResource Str.Screenshot.DragHintCalibrate}"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource Bg.Panel}"
                    BorderBrush="{StaticResource Line.TanStrong}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.Screenshot.ReviewHeader}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="RecognitionSummaryText"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource Text.Secondary}"
                                       Text="{DynamicResource Str.Screenshot.BeforeRecognition}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Alert.Text}"
                                   FontSize="11"
                                   Text="{DynamicResource Str.Screenshot.Slot1Leader}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RecognitionResultsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="9"
                                            Background="{StaticResource Bg.PanelInner}"
                                            BorderBrush="{StaticResource Line.TanStrong}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SlotText}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource Accent.Focus}"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Width="58"
                                                    Height="58"
                                                    Background="{StaticResource Bg.Backdrop}"
                                                    BorderBrush="{StaticResource Line.TanStrong}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    ClipToBounds="True"
                                                    ToolTip="{DynamicResource Str.Screenshot.SlotCropTooltip}">
                                                <Image Source="{Binding CropThumbnail}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="→"
                                                       Foreground="{StaticResource Text.Tertiary}"
                                                       FontSize="18"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                            <Border Grid.Column="3"
                                                    Width="58"
                                                    Height="58"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource Bg.Backdrop}"
                                                    BorderBrush="{StaticResource Info.Line}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    ClipToBounds="True"
                                                    ToolTip="{DynamicResource Str.Screenshot.DbIllustrationTooltip}">
                                                <Grid>
                                                    <TextBlock Text="DB"
                                                               Foreground="{StaticResource Text.Tertiary}"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Image Source="{Binding SelectedCharacterThumbnail}"
                                                           Margin="2"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="5"
                                                        VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding Choices}"
                                                              SelectedItem="{Binding SelectedChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayMemberPath="DisplayName"
                                                              IsTextSearchEnabled="True"
                                                              Style="{StaticResource DarkChoiceComboBoxStyle}"
                                                              MinWidth="230"/>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding BestScoreText}"
                                                               Foreground="{Binding ScoreBrush}"
                                                               FontWeight="SemiBold"/>
                                                </Grid>
                                                <TextBlock Margin="0,5,0,0"
                                                           FontSize="10"
                                                           Foreground="{StaticResource Text.Secondary}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding CandidateSummary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusBanner" Style="{StaticResource AlertBannerStyle}" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource Text.Secondary}"
                           TextWrapping="Wrap"
                           Text="{DynamicResource Str.Screenshot.ImageCompareNote}"/>
            </Border>
            <WrapPanel Grid.Column="1" Margin="12,0,0,0">
                <Button Content="{DynamicResource Str.Screenshot.Cancel}"
                        Margin="0,0,10,0"
                        Style="{StaticResource GhostButtonStyle}"
                        IsCancel="True"/>
                <Button Content="{DynamicResource Str.Screenshot.ApplyReviewToDeck}"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="ApplyButton_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
