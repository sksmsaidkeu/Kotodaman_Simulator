<Window x:Class="KotodamanWordFinder.DeckScreenshotImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="덱 스크린샷 불러오기"
        Width="1240"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#0F151D"
        Foreground="#F4F7FB"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7DD7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4D9AF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#263442"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#3C566B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#17212C"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#25445A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D5F7A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkChoiceComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#17212C"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#3A5368"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="#17212C"
                                                BorderBrush="#3A5368"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="9,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Foreground="#F4F7FB"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="#AFC2D1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#203241"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#4C6C83"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="360"
                                        Margin="0,3,0,0"
                                        Background="#121B24"
                                        BorderBrush="#49657A"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="덱 스크린샷 자동 불러오기"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#66D9EF"/>
            <TextBlock Margin="0,5,0,0"
                       Foreground="#9EB2C4"
                       TextWrapping="Wrap"
                       Text="게임의 덱 편성 화면 스크린샷을 선택한 뒤 12칸(4열 × 3행) 영역을 지정하세요. 프로그램이 각 슬롯 그림을 캐릭터 DB 이미지와 비교합니다. 애매한 슬롯은 자동으로 비워 두며, 12칸 확인과 중복 해소가 끝나기 전에는 덱에 적용되지 않습니다."/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="12"
                Background="#16212C"
                BorderBrush="#2E4659"
                BorderThickness="1"
                CornerRadius="10">
            <WrapPanel>
                <Button Content="스크린샷 선택"
                        Margin="0,0,8,8"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ChooseScreenshotButton_Click"/>
                <Button Content="클립보드 붙여넣기 (Ctrl+V)"
                        Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Windows 클립보드에 이미지나 이미지 파일이 있으면 바로 불러옵니다."
                        Click="PasteScreenshotButton_Click"/>
                <Button Content="자동 영역 추정"
                        Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="GuessGridButton_Click"/>
                <Button Content="전체 이미지를 4×3으로 사용"
                        Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="UseFullImageButton_Click"/>
                <Button x:Name="RecognizeButton"
                        Content="12칸 인식 시작"
                        Margin="0,0,8,8"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="RecognizeButton_Click"/>
                <CheckBox x:Name="UseLearnedSamplesCheckBox"
                          Content="학습 샘플 사용"
                          IsChecked="True"
                          Margin="8,7,10,8"
                          VerticalAlignment="Center"
                          Foreground="#CFE7D7"
                          ToolTip="검수로 확정한 과거 실제 덱 슬롯 이미지를 다음 인식에 함께 사용합니다."/>
                <CheckBox x:Name="UseAttributeColorAssistCheckBox"
                          Content="속성색 보조 판정"
                          IsChecked="True"
                          Margin="0,7,10,8"
                          VerticalAlignment="Center"
                          Foreground="#9FE9FF"
                          ToolTip="캐릭터 문자 원의 속성색과 DB 속성을 함께 사용해 비슷한 일러스트 후보 순서를 보정합니다. 확신이 낮으면 기존 ORB 결과를 그대로 유지합니다."/>
                <CheckBox x:Name="LearnVerifiedSamplesCheckBox"
                          Content="검수 결과 학습"
                          IsChecked="True"
                          Margin="0,7,10,8"
                          VerticalAlignment="Center"
                          Foreground="#CFE7D7"
                          ToolTip="현재 덱에 적용할 때 확정한 12칸 슬롯 이미지를 캐릭터별 학습 샘플로 저장합니다."/>
                <Button Content="현재 UI 학습 초기화"
                        Margin="0,0,8,8"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="공식 덱 UI가 바뀌었거나 잘못 학습한 샘플을 지우고 싶을 때 사용합니다."
                        Click="ClearLearningButton_Click"/>
                <TextBlock x:Name="LearningStatusText"
                           Margin="8,8,12,8"
                           VerticalAlignment="Center"
                           Foreground="#8FE3B1"
                           FontSize="11"
                           Text="학습 프로필 확인 중..."/>
                <TextBlock x:Name="SelectionInfoText"
                           Margin="8,8,0,0"
                           Foreground="#AFC2D1"
                           Text="스크린샷을 먼저 선택하세요."/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#080C12"
                    BorderBrush="#32475A"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">
                <Grid x:Name="PreviewHost"
                      Background="#080C12"
                      MouseLeftButtonDown="PreviewHost_MouseLeftButtonDown"
                      MouseMove="PreviewHost_MouseMove"
                      MouseLeftButtonUp="PreviewHost_MouseLeftButtonUp">
                    <Image x:Name="ScreenshotPreviewImage"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"/>
                    <Canvas x:Name="SelectionCanvas"
                            IsHitTestVisible="False"/>
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10"
                            Padding="8,5"
                            CornerRadius="6"
                            Background="#CC101821">
                        <TextBlock Foreground="#D6E7F2"
                                   FontSize="11"
                                   Text="마우스로 12칸 전체 영역을 드래그해서 보정할 수 있습니다."/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#141D27"
                    BorderBrush="#32475A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="인식 결과 검수"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="RecognitionSummaryText"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="#91A5B6"
                                       Text="인식 전"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="#D8B978"
                                   FontSize="11"
                                   Text="1번 슬롯 = 리더"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RecognitionResultsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="9"
                                            Background="#1B2733"
                                            BorderBrush="#31485A"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SlotText}"
                                                       FontWeight="Bold"
                                                       Foreground="#66D9EF"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Width="58"
                                                    Height="58"
                                                    Background="#0B1016"
                                                    BorderBrush="#41556A"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    ClipToBounds="True"
                                                    ToolTip="스크린샷에서 잘라낸 슬롯">
                                                <Image Source="{Binding CropThumbnail}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="→"
                                                       Foreground="#7890A4"
                                                       FontSize="18"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                            <Border Grid.Column="3"
                                                    Width="58"
                                                    Height="58"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#0B1016"
                                                    BorderBrush="#59A7C7"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    ClipToBounds="True"
                                                    ToolTip="현재 선택한 DB 캐릭터 일러스트">
                                                <Grid>
                                                    <TextBlock Text="DB"
                                                               Foreground="#60788C"
                                                               FontSize="10"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                    <Image Source="{Binding SelectedCharacterThumbnail}"
                                                           Margin="2"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="5"
                                                        VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding Choices}"
                                                              SelectedItem="{Binding SelectedChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              DisplayMemberPath="DisplayName"
                                                              IsTextSearchEnabled="True"
                                                              Style="{StaticResource DarkChoiceComboBoxStyle}"
                                                              MinWidth="230"/>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding BestScoreText}"
                                                               Foreground="{Binding ScoreBrush}"
                                                               FontWeight="SemiBold"/>
                                                </Grid>
                                                <TextBlock Margin="0,5,0,0"
                                                           FontSize="10"
                                                           Foreground="#8EA5B6"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding CandidateSummary}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#AFC2D1"
                       TextWrapping="Wrap"
                       Text="이미지 비교는 보조 기능입니다. 빈 슬롯이나 중복 캐릭터가 하나라도 남아 있으면 적용 버튼이 덱 변경을 수행하지 않습니다."/>
            <WrapPanel Grid.Column="1" Margin="12,0,0,0">
                <Button Content="취소"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"/>
                <Button Content="검수 결과를 현재 덱에 적용"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ApplyButton_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
