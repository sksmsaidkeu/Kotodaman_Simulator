<Window x:Class="KotodamanWordFinder.DeckEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="캐릭터 목록 / 덱 편성"
        Width="1440"
        Height="930"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="#10131A"
        Foreground="#F4F7FB"
        FontFamily="Malgun Gothic"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="EditorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A3342"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#46546A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomDetailExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="True">
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Focusable="False"
                                          Cursor="Hand"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Visibility="Collapsed"
                                              HorizontalAlignment="Stretch"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderSite" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EditorButtonStyle}">
            <Setter Property="Background" Value="#4B8BFF"/>
            <Setter Property="BorderBrush" Value="#4B8BFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EditorButtonStyle}">
            <Setter Property="Background" Value="#4A2932"/>
            <Setter Property="BorderBrush" Value="#75404D"/>
            <Setter Property="Foreground" Value="#FFD8DF"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Background" Value="#222A37"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="CaretBrush" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#3A4658"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#222A37"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#3A4658"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  RecognizesAccessKey="True"/>
                                                <Border Grid.Column="1"
                                                        Background="#1B222D"
                                                        BorderBrush="#3A4658"
                                                        BorderThickness="1,0,0,0"
                                                        CornerRadius="0,6,6,0">
                                                    <Path Width="10"
                                                          Height="6"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="#C8D1DE"
                                                          Data="M 0 0 L 10 0 L 5 6 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#293442"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#547086"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#263746"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#66D9EF"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Visibility="Hidden"
                                     Margin="8,2,38,2"
                                     Padding="3,0"
                                     Background="#222A37"
                                     Foreground="#F4F7FB"
                                     CaretBrush="#F4F7FB"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#171C26"
                                        BorderBrush="#46546A"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_EditableTextBox" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#222A37"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#29465A"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#547086"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4051"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#66D9EF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#718096"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6EDF7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#171C26"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#303A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="#202735"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#263746"/>
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#547086"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#1D4051"/>
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#66D9EF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="캐릭터 목록과 현재 덱 편성"
                       FontSize="25"
                       FontWeight="Bold"/>
            <TextBlock Margin="0,6,0,0"
                       Foreground="#AEB8C8"
                       TextWrapping="Wrap"
                       Text="캐릭터는 한 번만 등록하고 현재 덱에는 목록에서 최대 12명을 추가합니다. 등급과 주력(★)·애정(♥) 표시를 지정하면 캐릭터가 많아져도 원하는 캐릭터를 빠르게 찾을 수 있습니다."/>

            <Border Margin="0,12,0,0"
                    Background="#172330"
                    BorderBrush="#315068"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="덱 프리셋"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontWeight="Bold"
                               Foreground="#66D9EF"/>
                    <ComboBox x:Name="PresetComboBox"
                              Grid.Column="1"
                              MaxDropDownHeight="320"
                              HorizontalContentAlignment="Stretch"
                              SelectionChanged="PresetComboBox_SelectionChanged"
                              ToolTip="저장된 덱 프리셋 선택"/>
                    <TextBox x:Name="PresetNameTextBox"
                             Grid.Column="3"
                             ToolTip="새 프리셋 이름 또는 선택한 프리셋 이름"/>
                    <WrapPanel Grid.Column="5" VerticalAlignment="Center">
                        <Button Content="불러오기"
                                Margin="0,0,7,0"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="LoadPresetButton_Click"/>
                        <Button Content="현재 덱 저장"
                                Margin="0,0,7,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SavePresetButton_Click"/>
                        <Button Content="새 이름"
                                Margin="0,0,7,0"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="NewPresetButton_Click"/>
                        <Button Content="삭제"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="DeletePresetButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.72*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#171C26"
                    BorderBrush="#2A3342"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="등록된 캐릭터 목록"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="LibraryCountText"
                                   Grid.Column="1"
                                   Foreground="#66D9EF"
                                   VerticalAlignment="Center"
                                   Text="0명"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.78*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.78*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="LibrarySearchTextBox"
                                 Grid.ColumnSpan="7"
                                 ToolTip="공백으로 여러 조건을 입력하면 모두 만족하는 캐릭터를 찾습니다. 이름, 그룹, 문자, 등급, 속성, 종족, 형태명 검색 가능"
                                 TextChanged="LibrarySearchTextBox_TextChanged"/>
                        <StackPanel Grid.Column="8"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="FavoriteOnlyCheckBox"
                                      Content="★ 주력"
                                      Padding="2,0"
                                      Checked="LibraryCheckFilter_Changed"
                                      Unchecked="LibraryCheckFilter_Changed"/>
                            <CheckBox x:Name="BelovedOnlyCheckBox"
                                      Content="♥ 애정"
                                      Foreground="#FF9DB8"
                                      Margin="8,0,0,0"
                                      Padding="2,0"
                                      Checked="LibraryCheckFilter_Changed"
                                      Unchecked="LibraryCheckFilter_Changed"/>
                        </StackPanel>

                        <ComboBox x:Name="GroupFilterComboBox"
                                  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"
                                  MaxDropDownHeight="360"
                                  SelectionChanged="LibrarySelectionFilter_Changed"
                                  ToolTip="그룹 필터"/>
                        <ComboBox x:Name="CategoryFilterComboBox"
                                  Grid.Row="1" Grid.Column="2" Margin="0,7,0,0"
                                  SelectionChanged="LibrarySelectionFilter_Changed"
                                  ToolTip="등급 필터"/>
                        <ComboBox x:Name="AttributeFilterComboBox"
                                  Grid.Row="1" Grid.Column="4" Margin="0,7,0,0"
                                  SelectionChanged="LibrarySelectionFilter_Changed"
                                  ToolTip="속성 필터"/>
                        <ComboBox x:Name="SpeciesFilterComboBox"
                                  Grid.Row="1" Grid.Column="6" Margin="0,7,0,0"
                                  SelectionChanged="LibrarySelectionFilter_Changed"
                                  ToolTip="종족 필터"/>
                        <ComboBox x:Name="StatusFilterComboBox"
                                  Grid.Row="1" Grid.Column="8" Margin="0,7,0,0"
                                  SelectionChanged="LibrarySelectionFilter_Changed"
                                  ToolTip="등록 상태와 기능별 필터"/>

                        <TextBlock x:Name="LibrarySearchHintText"
                                   Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                   Margin="2,7,0,0"
                                   Foreground="#718096"
                                   FontSize="10"
                                   Text="예: 仮面ライダー し · 속성/종족도 검색 가능"/>
                        <ComboBox x:Name="SortComboBox"
                                  Grid.Row="2" Grid.Column="6"
                                  Margin="0,7,0,0"
                                  SelectionChanged="LibrarySelectionFilter_Changed"
                                  ToolTip="목록 정렬"/>
                        <Button Grid.Row="2" Grid.Column="8"
                                Content="초기화"
                                Margin="0,7,0,0"
                                Padding="10,6"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="ClearLibrarySearchButton_Click"/>
                    </Grid>

                    <ListBox x:Name="CharacterLibraryListBox"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="CharacterLibraryListBox_SelectionChanged"
                             MouseDoubleClick="CharacterLibraryListBox_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="CharacterLibraryListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="CharacterLibraryListBox_PreviewMouseLeftButtonUp">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"
                                           ItemWidth="126"
                                           ItemHeight="164"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="122"/>
                                <Setter Property="Height" Value="160"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="5"
                                        Background="#111923"
                                        CornerRadius="9"
                                        ToolTip="{Binding LettersText}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#344156"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInDeck}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#43C6D9"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="#12313A"/>
                                                </DataTrigger>
                                                <!-- 상세 편집 대상으로 클릭한 카드가 목록 안에서도 즉시 보이도록 강조합니다. -->
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FFD166"/>
                                                    <Setter Property="BorderThickness" Value="3"/>
                                                    <Setter Property="Background" Value="#2A2A22"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="90"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Width="88"
                                                Height="88"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#0C121A"
                                                BorderBrush="#3B5063"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       Visibility="{Binding ThumbnailVisibility}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PlaceholderText}"
                                                           Visibility="{Binding PlaceholderVisibility}"
                                                           Foreground="#718096"
                                                           FontSize="9"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Border Visibility="{Binding DeckBadgeVisibility}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="3"
                                                        Padding="4,1"
                                                        Background="#D70B1118"
                                                        CornerRadius="4">
                                                    <TextBlock Text="{Binding DeckPositionText}"
                                                               Foreground="#66D9EF"
                                                               FontSize="9"
                                                               FontWeight="Bold"/>
                                                </Border>
                                                <Border Visibility="{Binding ModeShiftBadgeVisibility}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="3"
                                                        Padding="4,1"
                                                        Background="#D7513E67"
                                                        BorderBrush="#B995FF"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ToolTip="2초 길게 눌러 동일명 모드시프트 전환">
                                                    <TextBlock Text="MS"
                                                               Foreground="#E8D8FF"
                                                               FontSize="9"
                                                               FontWeight="Bold"/>
                                                </Border>
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="3"
                                                        Padding="5,2"
                                                        Background="#E6A66B16"
                                                        BorderBrush="#FFD166"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="선택됨"
                                                               Foreground="#FFF3C4"
                                                               FontSize="9"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Row="1" Margin="1,3,1,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FavoriteMark}"
                                                       Foreground="#FFD166"
                                                       FontWeight="Bold"
                                                       Margin="0,0,2,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding BelovedMark}"
                                                       Foreground="#FF7FA6"
                                                       FontWeight="Bold"
                                                       Margin="0,0,2,0"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Name}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>

                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,2,0,2">
                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="#8FD7E7"
                                                       FontSize="9"
                                                       Margin="0,0,5,0"/>
                                            <ItemsControl ItemsSource="{Binding AttributeSegments}"
                                                          Margin="0,0,4,0"
                                                          VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Text}"
                                                                   Foreground="{Binding Foreground}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding SpeciesText}"
                                                       Foreground="#C9C2FF"
                                                       FontSize="9"
                                                       FontWeight="Bold"/>
                                        </StackPanel>

                                        <Button Grid.Row="3"
                                                Tag="{Binding Id}"
                                                Content="{Binding DeckActionText}"
                                                Height="25"
                                                Padding="7,2"
                                                FontSize="10"
                                                VerticalAlignment="Bottom"
                                                Click="LibraryDeckToggleButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource EditorButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInDeck}" Value="True">
                                                            <Setter Property="Background" Value="#4A2932"/>
                                                            <Setter Property="BorderBrush" Value="#75404D"/>
                                                            <Setter Property="Foreground" Value="#FFD8DF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInDeck}" Value="False">
                                                            <Setter Property="Background" Value="#2F6E63"/>
                                                            <Setter Property="BorderBrush" Value="#4AAE9C"/>
                                                            <Setter Property="Foreground" Value="#E5FFF9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0">
                            <Button Content="신규 입력"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource EditorButtonStyle}"
                                    Click="NewCharacterButton_Click"/>
                            <Button Content="웹 등록"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ImportCharacterFromWebButton_Click"/>
                            <Button Content="일괄 수정"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource EditorButtonStyle}"
                                    ToolTip="등록된 캐릭터의 이름·문자·등급·속성·종족·그룹을 표에서 한꺼번에 수정합니다."
                                    Click="BulkEditCharactersButton_Click"/>
                            <Button Content="삭제"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="DeleteCharacterButton_Click"/>
                        </WrapPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="12,0,0,8">
                            <Button x:Name="LibraryPrevPageButton"
                                    Content="‹"
                                    Width="34"
                                    Height="32"
                                    Padding="0"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource EditorButtonStyle}"
                                    ToolTip="이전 페이지"
                                    Click="LibraryPrevPageButton_Click"/>
                            <TextBlock x:Name="LibraryPageText"
                                       MinWidth="64"
                                       TextAlignment="Center"
                                       Foreground="#AFC2D1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="1 / 1"/>
                            <Button x:Name="LibraryNextPageButton"
                                    Content="›"
                                    Width="34"
                                    Height="32"
                                    Padding="0"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource EditorButtonStyle}"
                                    ToolTip="다음 페이지"
                                    Click="LibraryNextPageButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#171C26"
                    BorderBrush="#2A3342"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="현재 덱"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="DeckCountText"
                                   Grid.Column="1"
                                   Foreground="#66D9EF"
                                   VerticalAlignment="Center"
                                   Text="0 / 12명"/>
                    </Grid>

                    <ListBox x:Name="DeckListBox"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="DeckListBox_SelectionChanged"
                             MouseDoubleClick="DeckListBox_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="DeckListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="DeckListBox_PreviewMouseLeftButtonUp">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="3"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="90"
                                        Height="90"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#111923"
                                        BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="9"
                                        ClipToBounds="True"
                                        ToolTip="{Binding ToolTipText}">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}"
                                               Visibility="{Binding ThumbnailVisibility}"
                                               Stretch="Uniform"
                                               Margin="2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PlaceholderText}"
                                                   Visibility="{Binding PlaceholderVisibility}"
                                                   Foreground="#718096"
                                                   FontSize="9"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Padding="5,2"
                                                Background="#D90B1118"
                                                CornerRadius="5">
                                            <TextBlock Text="{Binding SlotText}"
                                                       Foreground="{Binding SlotForeground}"
                                                       FontWeight="Bold"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Visibility="{Binding ModeShiftBadgeVisibility}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Padding="5,2"
                                                Background="#D7513E67"
                                                BorderBrush="#B995FF"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                ToolTip="{Binding ModeShiftHintText}">
                                            <TextBlock Text="MS"
                                                       Foreground="#E8D8FF"
                                                       FontWeight="Bold"
                                                       FontSize="9"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="스샷"
                                Margin="0,0,8,8"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ImportDeckFromScreenshotButton_Click"/>
                        <Button Content="★ 리더"
                                Margin="0,0,8,8"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SetLeaderButton_Click"/>
                        <Button Content="↑"
                                Margin="0,0,8,8"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="MoveDeckUpButton_Click"/>
                        <Button Content="↓"
                                Margin="0,0,8,8"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="MoveDeckDownButton_Click"/>
                        <Button Content="제거"
                                Margin="0,0,8,8"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="RemoveFromDeckButton_Click"/>
                        <Button Content="비우기"
                                Margin="0,0,0,8"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="ClearDeckButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Expander x:Name="CharacterDetailExpander"
                  Grid.Row="2"
                  Margin="0,14,0,0"
                  IsExpanded="False"
                  Style="{StaticResource BottomDetailExpanderStyle}"
                  Foreground="#F4F7FB">
            <Expander.Header>
                <Border Background="#172330"
                        BorderBrush="#315068"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="13,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26"
                                Height="26"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Background="#223445"
                                BorderBrush="#4A7892"
                                BorderThickness="1"
                                CornerRadius="13">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#EAF7FB">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="↑"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                <Setter Property="Text" Value="↓"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="캐릭터 상세 편집"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#66D9EF"/>
                            <TextBlock Text="이름·문자·그룹·미라클·모드시프트·조건부 문자·이미지를 수정할 때만 펼치세요. 접으면 캐릭터 목록과 덱 영역이 넓어집니다."
                                       Margin="0,4,0,0"
                                       Foreground="#8FA0B4"
                                       FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Foreground="#B8EAF5"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="위로 펼치기"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                            <Setter Property="Text" Value="아래로 접기"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Expander.Header>

            <Border Margin="0,10,0,0"
                    Background="#172330"
                    BorderBrush="#315068"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="캐릭터 이름"
                                   Foreground="#AEB8C8"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="CharacterNameTextBox"
                                 ToolTip="예: キュウセイ"/>
                        <TextBlock Text="검색 별칭"
                                   Foreground="#AEB8C8"
                                   Margin="0,9,0,5"/>
                        <TextBox x:Name="CharacterSearchAliasesTextBox"
                                 ToolTip="한자 이름을 한글 등 다른 표기로 찾을 때 사용합니다. 여러 별칭은 쉼표 또는 ·로 구분하세요. 예: 카마도 탄지로"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="등급 / 분류"
                                   Foreground="#AEB8C8"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="CharacterCategoryComboBox"
                                  HorizontalContentAlignment="Stretch"
                                  ToolTip="스페셜, 레전드, 그랜드, 드림, 미라클, 오리지널, 콜라보 또는 기타"/>
                        <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                            <CheckBox x:Name="CharacterFavoriteCheckBox"
                                      Content="★ 주력"/>
                            <CheckBox x:Name="CharacterBelovedCheckBox"
                                      Content="♥ 애정"
                                      Foreground="#FF9DB8"
                                      Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="기본 사용 가능 문자"
                                   Foreground="#AEB8C8"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="CharacterLettersTextBox"
                                 ToolTip="항상 사용할 수 있는 기본 문자만 입력하세요. 예: き ゅ う 또는 きゅう"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5"
                                Margin="14,21,0,0"
                                VerticalAlignment="Top">
                        <Button x:Name="AddCharacterButton"
                                Content="새 캐릭터 추가"
                                Margin="0,0,0,7"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddCharacterButton_Click"/>
                        <Button x:Name="UpdateCharacterButton"
                                Content="선택 캐릭터 수정"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="현재 상세 편집 내용을 작업 중인 캐릭터에 반영하고 즉시 자동 저장합니다. 창을 닫을 때도 마지막 편집을 자동 저장합니다."
                                Click="UpdateCharacterButton_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.62*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.38*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="속성" Foreground="#AEB8C8" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CharacterAttributeComboBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="종족" Foreground="#AEB8C8" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CharacterSpeciesComboBox"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="서브 / 변환 속성"
                                   Foreground="#AEB8C8"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="CharacterSubAttributesTextBox"
                                 Margin="0,0,0,10"
                                 ToolTip="예: 木 闇. 메인 속성을 제외한 서브 속성 또는 속성 변환 대상을 공백·쉼표·/로 구분하세요."/>
                        <TextBlock Text="소속 그룹 (1개)"
                                   Foreground="#AEB8C8"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="CharacterGroupComboBox"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  HorizontalContentAlignment="Stretch"
                                  ToolTip="캐릭터의 기본 소속 그룹 하나를 입력하거나 기존 그룹에서 선택하세요."/>
                        <TextBlock Margin="2,5,0,0"
                                   Foreground="#718096"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Text="캐릭터의 실제 소속은 하나만 입력합니다."/>
                        <TextBlock Text="같이 취급되는 그룹 (여러 개 가능)"
                                   Foreground="#AEB8C8"
                                   Margin="0,10,0,5"/>
                        <TextBox x:Name="CharacterIncludedGroupsTextBox"
                                 ToolTip="이 소속 그룹의 캐릭터가 그룹 효과상 함께 취급되는 그룹을 쉼표 또는 ·로 구분하세요. 같은 소속 그룹 캐릭터 전체에 공유됩니다."/>
                        <TextBlock Margin="2,5,0,0"
                                   Foreground="#718096"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Text="예: 全の戦律 → 斬・砲・突・重・超・打の戦律. 이 칸은 미라클 부여 대상과 별개입니다."/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#202B38"
                            BorderBrush="#51436B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="MiracleLeaderEffectCheckBox"
                                              IsHitTestVisible="False"
                                              Focusable="False"
                                              VerticalAlignment="Center"
                                              ToolTip="대상 그룹과 부여 문자가 모두 입력되면 자동으로 효과 보유로 판단합니다."/>
                                    <TextBlock Text="미라클 리더 문자 부여 · 자동 적용"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="#D9C2FF"/>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="9"/>
                                        <ColumnDefinition Width="0.75*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="대상 그룹" Foreground="#AEB8C8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MiracleTargetGroupsTextBox"
                                                 ToolTip="미라클 리더가 실제로 문자를 부여할 대상 그룹을 쉼표 또는 ·로 구분하세요."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="부여 문자" Foreground="#AEB8C8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MiracleGrantedLettersTextBox"
                                                 ToolTip="리더일 때 대상 그룹에게 추가되는 문자를 입력하세요."/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="MiracleEffectNoteTextBox"
                                         Margin="0,8,0,0"
                                         ToolTip="효과 조건이나 원문 메모 (선택)"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Margin="6,0" Background="#51436B"/>

                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="DeckGroupLetterEffectCheckBox"
                                              IsHitTestVisible="False"
                                              Focusable="False"
                                              VerticalAlignment="Center"
                                              ToolTip="조건 그룹, 최소 인원수, 추가 문자가 모두 입력되면 자동으로 활성화됩니다."/>
                                    <TextBlock Text="덱 그룹 인원 조건 문자 · 자동 적용"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="#8FE3B1"/>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="조건 그룹" Foreground="#AEB8C8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DeckGroupConditionGroupsTextBox"
                                                 ToolTip="덱에서 인원수를 셀 그룹입니다. 여러 그룹이면 쉼표 또는 ·로 구분하세요."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="최소 인원" Foreground="#AEB8C8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DeckGroupConditionMinimumCountTextBox"
                                                 Text="2"
                                                 ToolTip="이 그룹 캐릭터가 덱에 몇 명 이상 있어야 발동하는지 입력하세요."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="추가 문자" Foreground="#AEB8C8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DeckGroupConditionGrantedLettersTextBox"
                                                 ToolTip="조건 달성 시 이 캐릭터 자신에게 추가되는 문자를 입력하세요."/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="DeckGroupConditionNoteTextBox"
                                         Margin="0,8,0,0"
                                         ToolTip="덱 조건 문자 효과 메모 (선택)"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="이름이 다른 모드시프트 연결"
                                       Foreground="#AEB8C8"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="ToggleRelatedFormEditorButton"
                                    Grid.Column="1"
                                    Content="연결 설정"
                                    Padding="10,5"
                                    Style="{StaticResource EditorButtonStyle}"
                                    Click="ToggleRelatedFormEditorButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="RelatedFormsSummaryText"
                                   Margin="2,0,0,0"
                                   Foreground="#8D98AA"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="연결된 이름 다른 모드시프트 없음"/>
                        <Grid x:Name="RelatedFormEditorPanel"
                              Margin="0,8,0,0"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RelatedFormComboBox"
                                      HorizontalContentAlignment="Stretch"
                                      ToolTip="이름이 달라 별도 캐릭터로 등록한 모드시프트 전후 형태를 선택하세요."/>
                            <Button x:Name="LinkRelatedFormButton"
                                    Grid.Column="2"
                                    Content="연결"
                                    Padding="11,8"
                                    Style="{StaticResource EditorButtonStyle}"
                                    Click="LinkRelatedFormButton_Click"/>
                            <Button x:Name="UnlinkRelatedFormButton"
                                    Grid.Column="4"
                                    Content="해제"
                                    Padding="11,8"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="UnlinkRelatedFormButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="조건부 / 변신 문자"
                                   Foreground="#AEB8C8"
                                   Margin="0,0,0,5"/>
                        <Border Background="#202B38"
                                BorderBrush="#3A5266"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,8">
                            <TextBlock x:Name="CharacterStateSummaryText"
                                       Text="추가 문자 상태 없음"
                                       Foreground="#BFD2DF"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="문자 상태 편집..."
                            Margin="0,21,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource EditorButtonStyle}"
                            Click="EditLetterStatesButton_Click"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#202B38"
                            BorderBrush="#3A5266"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="11">
                        <StackPanel>
                            <TextBlock Text="동일 이름 모드시프트 형태"
                                       FontWeight="SemiBold"
                                       Foreground="#B8EAF5"/>
                            <TextBlock x:Name="CharacterFormSummaryText"
                                       Margin="0,5,0,0"
                                       Foreground="#8D98AA"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="추가 형태 없음 · 기본 형태는 위의 문자와 이미지를 사용"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="2"
                            Content="동일명 형태 편집..."
                            VerticalAlignment="Center"
                            Style="{StaticResource EditorButtonStyle}"
                            Click="EditCharacterFormsButton_Click"/>
                </Grid>

                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="72"
                            Height="72"
                            Background="#202735"
                            BorderBrush="#3A5266"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="CharacterImagePreview"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                            <TextBlock x:Name="CharacterImagePlaceholder"
                                       Text="이미지 없음"
                                       Foreground="#7F8999"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="캐릭터 이미지"
                                   Foreground="#AEB8C8"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="CharacterImageFileText"
                                   Margin="0,4,0,0"
                                   Foreground="#8D98AA"
                                   FontSize="11"
                                   Text="등록된 이미지 없음"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#6F7D90"
                                   FontSize="10"
                                   Text="PNG/JPG/BMP/GIF/TIFF · 표준 PNG로 변환 저장 · 현재 덱과 손패에만 표시"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="4" VerticalAlignment="Center">
                        <Button Content="이미지 선택"
                                Margin="0,0,7,0"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="ChooseCharacterImageButton_Click"/>
                        <Button Content="이미지 제거"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="RemoveCharacterImageButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Grid>
            </Border>
        </Expander>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="EditorStatusText"
                           Foreground="#AEB8C8"
                           Text="덱 1번은 리더입니다. 캐릭터는 소속 그룹 하나를 가지며, 미라클 문자 부여는 해당 캐릭터가 리더일 때만 적용됩니다."/>
                <TextBlock Margin="0,4,0,0"
                           Foreground="#7F8999"
                           FontSize="11"
                           Text="캐릭터 추가/수정과 덱 변경은 짧은 시간 안의 연속 작업을 묶어 자동 저장합니다. 저장 시 characters.json, deck.json, deck_presets.json을 각각 백업한 뒤 기록합니다."/>
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="닫기"
                        Margin="0,0,8,0"
                        Style="{StaticResource EditorButtonStyle}"
                        IsCancel="True"/>
                <Button Content="저장하고 적용"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
