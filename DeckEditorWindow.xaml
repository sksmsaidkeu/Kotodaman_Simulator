<Window x:Class="KotodamanWordFinder.DeckEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:KotodamanWordFinder.Converters"
        Title="{DynamicResource Str.DeckEditor.Title}"
        Width="1440"
        Height="930"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ModalCardWindowStyle}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="Malgun Gothic"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <conv:GroupNameConverter x:Key="GroupNameConverter"/>
        <Style x:Key="EditorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Line.Tan}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.PinkSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BottomDetailExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="True">
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Focusable="False"
                                          Cursor="Hand"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0"
                                          HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Visibility="Collapsed"
                                              HorizontalAlignment="Stretch"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderSite" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EditorButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Accent.Pink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Pink}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
        </Style>
        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource EditorButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Rose.Face}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Rose.Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Rose.Text}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  RecognizesAccessKey="True"/>
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource Bg.PanelInner}"
                                                        BorderBrush="{StaticResource Line.Tan}"
                                                        BorderThickness="1,0,0,0"
                                                        CornerRadius="0,6,6,0">
                                                    <Path Width="10"
                                                          Height="6"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="{StaticResource Bg.Ivory}"
                                                          Data="M 0 0 L 10 0 L 5 6 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Info.Line}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Bg.PanelInner}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Visibility="Hidden"
                                     Margin="8,2,38,2"
                                     Padding="3,0"
                                     Background="{StaticResource Chip.Dark}"
                                     Foreground="{StaticResource Text.Primary}"
                                     CaretBrush="{StaticResource Text.Primary}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Accent.PinkSoft}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_EditableTextBox" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Info.Line}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Accent.OrangeDeep}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Bg.PanelInner}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{StaticResource Bg.PanelInner}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="{StaticResource Bg.PanelInner}"/>
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource Info.Line}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="{StaticResource Accent.OrangeDeep}"/>
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목은 카드 크롬이 창의 Title 로 그립니다. 여기에는 설명만 둡니다. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Foreground="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Text="{DynamicResource Str.DeckEditor.Description}"/>

            <Border Margin="0,12,0,0"
                    Background="{StaticResource Bg.PanelInner}"
                    BorderBrush="{StaticResource Line.TanStrong}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource Str.DeckPreset}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent.Focus}"/>
                    <ComboBox x:Name="PresetComboBox"
                              Grid.Column="1"
                              MaxDropDownHeight="320"
                              HorizontalContentAlignment="Stretch"
                              SelectionChanged="PresetComboBox_SelectionChanged"
                              ToolTip="{DynamicResource Str.DeckPresetTooltip}"/>
                    <TextBox x:Name="PresetNameTextBox"
                             Grid.Column="3"
                             ToolTip="{DynamicResource Str.DeckEditor.PresetNameTooltip}"/>
                    <WrapPanel Grid.Column="5" VerticalAlignment="Center">
                        <Button Content="{DynamicResource Str.DeckEditor.LoadPreset}"
                                Margin="0,0,7,0"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="LoadPresetButton_Click"/>
                        <Button Content="{DynamicResource Str.DeckEditor.SaveCurrentDeck}"
                                Margin="0,0,7,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SavePresetButton_Click"/>
                        <Button Content="{DynamicResource Str.DeckEditor.NewName}"
                                Margin="0,0,7,0"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="NewPresetButton_Click"/>
                        <Button Content="{DynamicResource Str.DeckEditor.Delete}"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="DeletePresetButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.72*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Bg.Panel}"
                    BorderBrush="{StaticResource Line.Tan}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.DeckEditor.LibraryHeader}"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="LibraryCountText"
                                   Grid.Column="1"
                                   Foreground="{StaticResource Accent.Focus}"
                                   VerticalAlignment="Center"
                                   Text="{DynamicResource Str.DeckEditor.CountInitial}"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.78*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="0.78*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="LibrarySearchTextBox"
                                 Grid.ColumnSpan="7"
                                 ToolTip="{DynamicResource Str.DeckEditor.SearchTooltip}"
                                 TextChanged="LibrarySearchTextBox_TextChanged"/>
                        <StackPanel Grid.Column="8"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="FavoriteOnlyCheckBox"
                                      Content="{DynamicResource Str.DeckEditor.MainBadge}"
                                      Padding="2,0"
                                      Checked="LibraryCheckFilter_Changed"
                                      Unchecked="LibraryCheckFilter_Changed"/>
                            <CheckBox x:Name="BelovedOnlyCheckBox"
                                      Content="{DynamicResource Str.DeckEditor.LoveBadge}"
                                      Foreground="{StaticResource Rose.Text}"
                                      Margin="8,0,0,0"
                                      Padding="2,0"
                                      Checked="LibraryCheckFilter_Changed"
                                      Unchecked="LibraryCheckFilter_Changed"/>
                        </StackPanel>

                        <ComboBox x:Name="GroupFilterComboBox"
                                  Grid.Row="1" Grid.Column="0" Margin="0,7,0,0"
                                  MaxDropDownHeight="360"
                                  SelectionChanged="LibrarySelectionFilter_Changed"
                                  ToolTip="{DynamicResource Str.DeckEditor.GroupFilterTooltip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource GroupNameConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="CategoryFilterComboBox"
                                  Grid.Row="1" Grid.Column="2" Margin="0,7,0,0"
                                  SelectionChanged="LibrarySelectionFilter_Changed"
                                  ToolTip="{DynamicResource Str.DeckEditor.CategoryFilterTooltip}"/>
                        <ComboBox x:Name="AttributeFilterComboBox"
                                  Grid.Row="1" Grid.Column="4" Margin="0,7,0,0"
                                  SelectionChanged="LibrarySelectionFilter_Changed"
                                  ToolTip="{DynamicResource Str.DeckEditor.AttributeFilterTooltip}"/>
                        <ComboBox x:Name="SpeciesFilterComboBox"
                                  Grid.Row="1" Grid.Column="6" Margin="0,7,0,0"
                                  SelectionChanged="LibrarySelectionFilter_Changed"
                                  ToolTip="{DynamicResource Str.DeckEditor.SpeciesFilterTooltip}"/>
                        <ComboBox x:Name="StatusFilterComboBox"
                                  Grid.Row="1" Grid.Column="8" Margin="0,7,0,0"
                                  SelectionChanged="LibrarySelectionFilter_Changed"
                                  ToolTip="{DynamicResource Str.DeckEditor.StatusFilterTooltip}"/>

                        <TextBlock x:Name="LibrarySearchHintText"
                                   Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                   Margin="2,7,0,0"
                                   Foreground="{StaticResource Text.Tertiary}"
                                   FontSize="10"
                                   Text="{DynamicResource Str.DeckEditor.SearchPlaceholder}"/>
                        <ComboBox x:Name="SortComboBox"
                                  Grid.Row="2" Grid.Column="6"
                                  Margin="0,7,0,0"
                                  SelectionChanged="LibrarySelectionFilter_Changed"
                                  ToolTip="{DynamicResource Str.DeckEditor.SortTooltip}"/>
                        <Button Grid.Row="2" Grid.Column="8"
                                Content="{DynamicResource Str.DeckEditor.ResetFilters}"
                                Margin="0,7,0,0"
                                Padding="10,6"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="ClearLibrarySearchButton_Click"/>
                    </Grid>

                    <ListBox x:Name="CharacterLibraryListBox"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="CharacterLibraryListBox_SelectionChanged"
                             MouseDoubleClick="CharacterLibraryListBox_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="CharacterLibraryListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="CharacterLibraryListBox_PreviewMouseLeftButtonUp">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"
                                           ItemWidth="126"
                                           ItemHeight="164"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="122"/>
                                <Setter Property="Height" Value="160"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="5"
                                        Background="{StaticResource Bg.Panel}"
                                        CornerRadius="9"
                                        ToolTip="{Binding LettersText}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Line.TanStrong}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInDeck}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="{StaticResource Info.Face}"/>
                                                </DataTrigger>
                                                <!-- 상세 편집 대상으로 클릭한 카드가 목록 안에서도 즉시 보이도록 강조합니다. -->
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Status.Warn}"/>
                                                    <Setter Property="BorderThickness" Value="3"/>
                                                    <Setter Property="Background" Value="{StaticResource Bg.PanelInner}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="90"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Width="88"
                                                Height="88"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource Bg.Backdrop}"
                                                BorderBrush="{StaticResource Line.TanStrong}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}"
                                                       Visibility="{Binding ThumbnailVisibility}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PlaceholderText}"
                                                           Visibility="{Binding PlaceholderVisibility}"
                                                           Foreground="{StaticResource Text.Tertiary}"
                                                           FontSize="9"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Border Visibility="{Binding DeckBadgeVisibility}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="3"
                                                        Padding="4,1"
                                                        Background="{StaticResource Overlay.Scrim}"
                                                        CornerRadius="4">
                                                    <TextBlock Text="{Binding DeckPositionText}"
                                                               Foreground="{StaticResource Accent.Focus}"
                                                               FontSize="9"
                                                               FontWeight="Bold"/>
                                                </Border>
                                                <Border Visibility="{Binding ModeShiftBadgeVisibility}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="3"
                                                        Padding="4,1"
                                                        Background="{StaticResource Overlay.Special}"
                                                        BorderBrush="{StaticResource Special.Line}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        ToolTip="{DynamicResource Str.DeckEditor.HoldToggleSameNameTooltip}">
                                                    <TextBlock Text="MS"
                                                               Foreground="{StaticResource Status.Special}"
                                                               FontSize="9"
                                                               FontWeight="Bold"/>
                                                </Border>
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="3"
                                                        Padding="5,2"
                                                        Background="{StaticResource Overlay.Alert}"
                                                        BorderBrush="{StaticResource Status.Warn}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{DynamicResource Str.DeckEditor.SelectedBadge}"
                                                               Foreground="{StaticResource Alert.Text}"
                                                               FontSize="9"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Row="1" Margin="1,3,1,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FavoriteMark}"
                                                       Foreground="{StaticResource Status.Warn}"
                                                       FontWeight="Bold"
                                                       Margin="0,0,2,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding BelovedMark}"
                                                       Foreground="{StaticResource Rose.Text}"
                                                       FontWeight="Bold"
                                                       Margin="0,0,2,0"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Name}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>

                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,2,0,2">
                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="{StaticResource Status.Info}"
                                                       FontSize="9"
                                                       Margin="0,0,5,0"/>
                                            <ItemsControl ItemsSource="{Binding AttributeSegments}"
                                                          Margin="0,0,4,0"
                                                          VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Text}"
                                                                   Foreground="{Binding Foreground}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding SpeciesText}"
                                                       Foreground="{StaticResource Status.Special}"
                                                       FontSize="9"
                                                       FontWeight="Bold"/>
                                        </StackPanel>

                                        <Button Grid.Row="3"
                                                Tag="{Binding Id}"
                                                Content="{Binding DeckActionText}"
                                                Height="25"
                                                Padding="7,2"
                                                FontSize="10"
                                                VerticalAlignment="Bottom"
                                                Click="LibraryDeckToggleButton_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource EditorButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInDeck}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Rose.Face}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource Rose.Line}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Rose.Text}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInDeck}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource Success.Face}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource Success.Line}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Status.Success}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0">
                            <Button Content="{DynamicResource Str.DeckEditor.NewEntry}"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource EditorButtonStyle}"
                                    Click="NewCharacterButton_Click"/>
                            <Button Content="{DynamicResource Str.DeckEditor.WebRegister}"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ImportCharacterFromWebButton_Click"/>
                            <Button Content="{DynamicResource Str.DeckEditor.BulkEdit}"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource EditorButtonStyle}"
                                    ToolTip="{DynamicResource Str.DeckEditor.BulkEditTooltip}"
                                    Click="BulkEditCharactersButton_Click"/>
                            <Button Content="{DynamicResource Str.DeckEditor.Delete}"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="DeleteCharacterButton_Click"/>
                        </WrapPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="12,0,0,8">
                            <Button x:Name="LibraryPrevPageButton"
                                    Content="‹"
                                    Width="34"
                                    Height="32"
                                    Padding="0"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource EditorButtonStyle}"
                                    ToolTip="{DynamicResource Str.DeckEditor.PrevPage}"
                                    Click="LibraryPrevPageButton_Click"/>
                            <TextBlock x:Name="LibraryPageText"
                                       MinWidth="64"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="1 / 1"/>
                            <Button x:Name="LibraryNextPageButton"
                                    Content="›"
                                    Width="34"
                                    Height="32"
                                    Padding="0"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource EditorButtonStyle}"
                                    ToolTip="{DynamicResource Str.DeckEditor.NextPage}"
                                    Click="LibraryNextPageButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource Bg.Panel}"
                    BorderBrush="{StaticResource Line.Tan}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Str.DeckEditor.CurrentDeckHeader}"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="DeckCountText"
                                   Grid.Column="1"
                                   Foreground="{StaticResource Accent.Focus}"
                                   VerticalAlignment="Center"
                                   Text="{DynamicResource Str.DeckEditor.DeckCountInitial}"/>
                    </Grid>

                    <ListBox x:Name="DeckListBox"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="DeckListBox_SelectionChanged"
                             MouseDoubleClick="DeckListBox_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="DeckListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="DeckListBox_PreviewMouseLeftButtonUp">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="3"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="90"
                                        Height="90"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="9"
                                        ClipToBounds="True"
                                        ToolTip="{Binding ToolTipText}">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}"
                                               Visibility="{Binding ThumbnailVisibility}"
                                               Stretch="Uniform"
                                               Margin="2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PlaceholderText}"
                                                   Visibility="{Binding PlaceholderVisibility}"
                                                   Foreground="{StaticResource Text.Tertiary}"
                                                   FontSize="9"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Padding="5,2"
                                                Background="{StaticResource Overlay.Scrim}"
                                                CornerRadius="5">
                                            <TextBlock Text="{Binding SlotText}"
                                                       Foreground="{Binding SlotForeground}"
                                                       FontWeight="Bold"
                                                       FontSize="10"/>
                                        </Border>
                                        <Border Visibility="{Binding ModeShiftBadgeVisibility}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="4"
                                                Padding="5,2"
                                                Background="{StaticResource Overlay.Special}"
                                                BorderBrush="{StaticResource Special.Line}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                ToolTip="{Binding ModeShiftHintText}">
                                            <TextBlock Text="MS"
                                                       Foreground="{StaticResource Status.Special}"
                                                       FontWeight="Bold"
                                                       FontSize="9"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="{DynamicResource Str.DeckEditor.Screenshot}"
                                Margin="0,0,8,8"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ImportDeckFromScreenshotButton_Click"/>
                        <Button Content="{DynamicResource Str.DeckEditor.LeaderBadge}"
                                Margin="0,0,8,8"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="SetLeaderButton_Click"/>
                        <Button Content="↑"
                                Margin="0,0,8,8"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="MoveDeckUpButton_Click"/>
                        <Button Content="↓"
                                Margin="0,0,8,8"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="MoveDeckDownButton_Click"/>
                        <Button Content="{DynamicResource Str.DeckEditor.Remove}"
                                Margin="0,0,8,8"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="RemoveFromDeckButton_Click"/>
                        <Button Content="{DynamicResource Str.DeckEditor.ClearDeck}"
                                Margin="0,0,0,8"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="ClearDeckButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Expander x:Name="CharacterDetailExpander"
                  Grid.Row="2"
                  Margin="0,14,0,0"
                  IsExpanded="False"
                  Style="{StaticResource BottomDetailExpanderStyle}"
                  Foreground="{StaticResource Text.Primary}">
            <Expander.Header>
                <Border Background="{StaticResource Bg.PanelInner}"
                        BorderBrush="{StaticResource Line.TanStrong}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="13,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26"
                                Height="26"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Background="{StaticResource Bg.Ivory}"
                                BorderBrush="{StaticResource Line.Soft}"
                                BorderThickness="1"
                                CornerRadius="13">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Text.Primary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="↑"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                <Setter Property="Text" Value="↓"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Str.DeckEditor.DetailEditHeader}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Accent.Focus}"/>
                            <TextBlock Text="{DynamicResource Str.DeckEditor.DetailEditHint}"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   Foreground="{StaticResource Status.Info}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource Str.DeckEditor.ExpandUp}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Str.DeckEditor.CollapseDown}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Expander.Header>

            <Border Margin="0,10,0,0"
                    Background="{StaticResource Bg.PanelInner}"
                    BorderBrush="{StaticResource Line.TanStrong}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="440">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str.DeckEditor.NameLabel}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="CharacterNameTextBox"
                                 ToolTip="{DynamicResource Str.DeckEditor.NameTooltip}"/>
                        <TextBlock Text="{DynamicResource Str.DeckEditor.AliasLabel}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,9,0,5"/>
                        <TextBox x:Name="CharacterSearchAliasesTextBox"
                                 ToolTip="{DynamicResource Str.DeckEditor.AliasTooltip}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Str.DeckEditor.CategoryLabel}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="CharacterCategoryComboBox"
                                  HorizontalContentAlignment="Stretch"
                                  ToolTip="{DynamicResource Str.DeckEditor.CategoryTooltip}"/>
                        <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                            <CheckBox x:Name="CharacterFavoriteCheckBox"
                                      Content="{DynamicResource Str.DeckEditor.MainBadge}"/>
                            <CheckBox x:Name="CharacterBelovedCheckBox"
                                      Content="{DynamicResource Str.DeckEditor.LoveBadge}"
                                      Foreground="{StaticResource Rose.Text}"
                                      Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{DynamicResource Str.DeckEditor.BaseLettersLabel}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="CharacterLettersTextBox"
                                 ToolTip="{DynamicResource Str.DeckEditor.BaseLettersTooltip}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5"
                                Margin="14,21,0,0"
                                VerticalAlignment="Top">
                        <Button x:Name="AddCharacterButton"
                                Content="{DynamicResource Str.DeckEditor.AddNewCharacter}"
                                Margin="0,0,0,7"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddCharacterButton_Click"/>
                        <Button x:Name="UpdateCharacterButton"
                                Content="{DynamicResource Str.DeckEditor.UpdateSelectedCharacter}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="{DynamicResource Str.DeckEditor.UpdateSelectedTooltip}"
                                Click="UpdateCharacterButton_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.62*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.38*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.DeckEditor.AttributeLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CharacterAttributeComboBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Str.DeckEditor.SpeciesLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CharacterSpeciesComboBox"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{DynamicResource Str.DeckEditor.SubAttributeLabel}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="CharacterSubAttributesTextBox"
                                 Margin="0,0,0,10"
                                 ToolTip="{DynamicResource Str.DeckEditor.SubAttributeTooltip}"/>
                        <TextBlock Text="{DynamicResource Str.DeckEditor.GroupLabel}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="CharacterGroupComboBox"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  HorizontalContentAlignment="Stretch"
                                  ToolTip="{DynamicResource Str.DeckEditor.GroupTooltip}"/>
                        <TextBlock Margin="2,5,0,0"
                                   Foreground="{StaticResource Text.Tertiary}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource Str.DeckEditor.GroupHint}"/>
                        <TextBlock Text="{DynamicResource Str.DeckEditor.IncludedGroupsLabel}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,10,0,5"/>
                        <TextBox x:Name="CharacterIncludedGroupsTextBox"
                                 ToolTip="{DynamicResource Str.DeckEditor.IncludedGroupsTooltip}"/>
                        <TextBlock Margin="2,5,0,0"
                                   Foreground="{StaticResource Text.Tertiary}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource Str.DeckEditor.IncludedGroupsExample}"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="{StaticResource Bg.PanelInner}"
                            BorderBrush="{StaticResource Special.Line}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="MiracleLeaderEffectCheckBox"
                                              IsHitTestVisible="False"
                                              Focusable="False"
                                              VerticalAlignment="Center"
                                              ToolTip="{DynamicResource Str.DeckEditor.MiracleAutoTooltip}"/>
                                    <TextBlock Text="{DynamicResource Str.DeckEditor.MiracleHeader}"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Status.Special}"/>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="9"/>
                                        <ColumnDefinition Width="0.75*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str.DeckEditor.TargetGroupLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MiracleTargetGroupsTextBox"
                                                 ToolTip="{DynamicResource Str.DeckEditor.MiracleTargetGroupTooltip}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Str.DeckEditor.GrantedLettersLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MiracleGrantedLettersTextBox"
                                                 ToolTip="{DynamicResource Str.DeckEditor.GrantedLettersTooltip}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="MiracleEffectNoteTextBox"
                                         Margin="0,8,0,0"
                                         ToolTip="{DynamicResource Str.DeckEditor.EffectNoteTooltip}"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Margin="6,0" Background="{StaticResource Special.Line}"/>

                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="DeckGroupLetterEffectCheckBox"
                                              IsHitTestVisible="False"
                                              Focusable="False"
                                              VerticalAlignment="Center"
                                              ToolTip="{DynamicResource Str.DeckEditor.DeckConditionAutoTooltip}"/>
                                    <TextBlock Text="{DynamicResource Str.DeckEditor.DeckConditionHeader}"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Status.Success}"/>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str.DeckEditor.ConditionGroupLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DeckGroupConditionGroupsTextBox"
                                                 ToolTip="{DynamicResource Str.DeckEditor.ConditionGroupTooltip}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Str.DeckEditor.MinMembersLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DeckGroupConditionMinimumCountTextBox"
                                                 Text="2"
                                                 ToolTip="{DynamicResource Str.DeckEditor.MinMembersTooltip}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{DynamicResource Str.DeckEditor.ExtraLetterLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DeckGroupConditionGrantedLettersTextBox"
                                                 ToolTip="{DynamicResource Str.DeckEditor.ExtraLetterTooltip}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="DeckGroupConditionNoteTextBox"
                                         Margin="0,8,0,0"
                                         ToolTip="{DynamicResource Str.DeckEditor.DeckConditionNoteTooltip}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.DeckEditor.LinkedModeShiftHeader}"
                                       Foreground="{StaticResource Text.Secondary}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="ToggleRelatedFormEditorButton"
                                    Grid.Column="1"
                                    Content="{DynamicResource Str.DeckEditor.LinkSettings}"
                                    Padding="10,5"
                                    Style="{StaticResource EditorButtonStyle}"
                                    Click="ToggleRelatedFormEditorButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="RelatedFormsSummaryText"
                                   Margin="2,0,0,0"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource Str.DeckEditor.NoLinkedForm}"/>
                        <Grid x:Name="RelatedFormEditorPanel"
                              Margin="0,8,0,0"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RelatedFormComboBox"
                                      HorizontalContentAlignment="Stretch"
                                      ToolTip="{DynamicResource Str.DeckEditor.LinkedFormPickerTooltip}"/>
                            <Button x:Name="LinkRelatedFormButton"
                                    Grid.Column="2"
                                    Content="{DynamicResource Str.DeckEditor.Link}"
                                    Padding="11,8"
                                    Style="{StaticResource EditorButtonStyle}"
                                    Click="LinkRelatedFormButton_Click"/>
                            <Button x:Name="UnlinkRelatedFormButton"
                                    Grid.Column="4"
                                    Content="{DynamicResource Str.DeckEditor.Unlink}"
                                    Padding="11,8"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="UnlinkRelatedFormButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Str.DeckEditor.ConditionalLettersHeader}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,0,0,5"/>
                        <Border Background="{StaticResource Bg.PanelInner}"
                                BorderBrush="{StaticResource Line.TanStrong}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,8">
                            <TextBlock x:Name="CharacterStateSummaryText"
                                       Text="{DynamicResource Str.DeckEditor.NoLetterStates}"
                                       Foreground="{StaticResource Text.Primary}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="4"
                            Content="{DynamicResource Str.DeckEditor.EditLetterStates}"
                            Margin="0,21,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource EditorButtonStyle}"
                            Click="EditLetterStatesButton_Click"/>
                </Grid>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Bg.PanelInner}"
                            BorderBrush="{StaticResource Line.TanStrong}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="11">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.DeckEditor.SameNameFormsHeader}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Status.Info}"/>
                            <TextBlock x:Name="CharacterFormSummaryText"
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource Text.Secondary}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="{DynamicResource Str.DeckEditor.NoExtraForms}"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="2"
                            Content="{DynamicResource Str.DeckEditor.EditSameNameForms}"
                            VerticalAlignment="Center"
                            Style="{StaticResource EditorButtonStyle}"
                            Click="EditCharacterFormsButton_Click"/>
                </Grid>

                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="72"
                            Height="72"
                            Background="{StaticResource Bg.PanelInner}"
                            BorderBrush="{StaticResource Line.TanStrong}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="CharacterImagePreview"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                            <TextBlock x:Name="CharacterImagePlaceholder"
                                       Text="{DynamicResource Str.DeckEditor.NoImage}"
                                       Foreground="{StaticResource Text.Tertiary}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str.DeckEditor.ImageHeader}"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="CharacterImageFileText"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource Text.Secondary}"
                                   FontSize="11"
                                   Text="{DynamicResource Str.DeckEditor.NoRegisteredImage}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource Text.Tertiary}"
                                   FontSize="10"
                                   Text="{DynamicResource Str.DeckEditor.ImageFormatHint}"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="4" VerticalAlignment="Center">
                        <Button Content="{DynamicResource Str.DeckEditor.SelectImage}"
                                Margin="0,0,7,0"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="ChooseCharacterImageButton_Click"/>
                        <Button Content="{DynamicResource Str.DeckEditor.RemoveImage}"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="RemoveCharacterImageButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Grid>
            </ScrollViewer>
            </Border>
        </Expander>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <Border x:Name="EditorStatusBanner" Style="{StaticResource AlertBannerStyle}">
                    <TextBlock x:Name="EditorStatusText"
                               Foreground="{StaticResource Text.Secondary}"
                               Text="{DynamicResource Str.DeckEditor.LeaderHint}"/>
                </Border>
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource Text.Tertiary}"
                           FontSize="11"
                           Text="{DynamicResource Str.DeckEditor.AutoSaveHint}"/>
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str.DeckEditor.Close}"
                        Margin="0,0,10,0"
                        Style="{StaticResource GhostButtonStyle}"
                        IsCancel="True"/>
                <Button Content="{DynamicResource Str.DeckEditor.SaveAndApply}"
                        Style="{StaticResource ActionButtonStyle}"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
