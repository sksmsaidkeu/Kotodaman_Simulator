<Window x:Class="KotodamanWordFinder.LetterStateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.LetterState.Title}"
        Width="900"
        Height="650"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ModalCardWindowStyle}"
        Foreground="{StaticResource Text.Primary}"
        FontFamily="Malgun Gothic"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="EditorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Line.Tan}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.PinkSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Accent.Pink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent.Pink}"/>
            <!-- 글자를 안 적으면 EditorButtonStyle 의 Text.Primary 가 남아 대비 2.02 가 된다. -->
            <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource EditorButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Rose.Face}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Rose.Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Rose.Text}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="39"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line.Tan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  RecognizesAccessKey="True"/>
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource Bg.PanelInner}"
                                                        BorderBrush="{StaticResource Line.Tan}"
                                                        BorderThickness="1,0,0,0"
                                                        CornerRadius="0,6,6,0">
                                                    <Path Width="10"
                                                          Height="6"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="{StaticResource Bg.Ivory}"
                                                          Data="M 0 0 L 10 0 L 5 6 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Info.Line}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource Bg.PanelInner}"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Visibility="Hidden"
                                     Margin="8,2,38,2"
                                     Padding="3,0"
                                     Background="{StaticResource Chip.Dark}"
                                     Foreground="{StaticResource Text.Primary}"
                                     CaretBrush="{StaticResource Text.Primary}"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Stretch"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Accent.PinkSoft}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_EditableTextBox" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource Chip.Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Bg.Ivory}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Info.Line}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Accent.OrangeDeep}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Text.Tertiary}"/>
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Bg.PanelInner}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{StaticResource Bg.PanelInner}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="SelectionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="9"
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="{StaticResource Bg.PanelInner}"/>
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource Info.Line}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="{StaticResource Accent.OrangeDeep}"/>
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource Accent.Focus}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 제목은 카드 크롬이 창의 Title 로 그립니다(캐릭터 이름은 생성자가 Title 에 넣습니다). -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Foreground="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap"
                       Text="{DynamicResource Str.LetterState.Description}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Bg.Panel}"
                    BorderBrush="{StaticResource Line.Tan}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Str.LetterState.ListTitle}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>
                    <ListBox x:Name="StateListBox"
                             Grid.Row="1"
                             SelectionChanged="StateListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        BorderBrush="{StaticResource Line.TanStrong}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinHeight="78"
                                        Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Kind}"
                                                       Foreground="{StaticResource Accent.Focus}"
                                                       FontSize="11"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ModeText}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Status.Warn}"
                                                   FontSize="11"/>
                                        <TextBlock Text="{Binding LettersText}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Text.Primary}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Note}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="{DynamicResource Str.LetterState.NewState}"
                                Margin="0,0,8,0"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="NewStateButton_Click"/>
                        <Button Content="{DynamicResource Str.LetterState.DeleteSelected}"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="DeleteStateButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource Bg.Panel}"
                    BorderBrush="{StaticResource Line.Tan}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{DynamicResource Str.LetterState.InfoHeader}"
                               FontSize="17"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.LetterState.NameLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,5"/>
                            <TextBox x:Name="StateNameTextBox" ToolTip="{DynamicResource Str.LetterState.NameTooltip}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Str.LetterState.KindLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="StateKindComboBox" HorizontalContentAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Str.LetterState.LettersLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,5"/>
                        <TextBox x:Name="StateLettersTextBox" ToolTip="{DynamicResource Str.LetterState.LettersTooltip}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Str.LetterState.ApplyModeLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="StateMergeModeComboBox" HorizontalContentAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource Str.LetterState.ConditionLabel}" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,5"/>
                        <TextBox x:Name="StateNoteTextBox"
                                 Height="88"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 ToolTip="{DynamicResource Str.LetterState.ConditionTooltip}"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="5" Margin="0,2,0,0">
                        <Button x:Name="AddStateButton"
                                Content="{DynamicResource Str.LetterState.AddButton}"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="AddStateButton_Click"/>
                        <Button x:Name="UpdateStateButton"
                                Content="{DynamicResource Str.LetterState.UpdateButton}"
                                Style="{StaticResource EditorButtonStyle}"
                                Click="UpdateStateButton_Click"/>
                    </WrapPanel>

                    <Border x:Name="StateStatusBanner"
                            Grid.Row="6"
                            Style="{StaticResource AlertBannerStyle}"
                            Margin="0,14,0,0">
                        <TextBlock x:Name="StateStatusText"
                                   Foreground="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource Str.LetterState.UsageHint}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Text.Tertiary}"
                       Text="{DynamicResource Str.LetterState.DefaultHiddenHint}"/>
            <WrapPanel Grid.Column="1">
                <Button Content="{DynamicResource Str.LetterState.Cancel}"
                        Margin="0,0,10,0"
                        Style="{StaticResource GhostButtonStyle}"
                        IsCancel="True"/>
                <Button Content="{DynamicResource Str.LetterState.SaveAndReturn}"
                        Style="{StaticResource ActionButtonStyle}"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
